# Variables d'environnement pour le développement local
# NE PAS COMMITTER CE FICHIER !
# Copier ce fichier en .env et remplir les valeurs

# === Supabase (Auth + Queue) ===
SUPABASE_DATABASE_URL=xxx
SUPABASE_TRANSACTION_POOLER=xxx
SUPABASE_URL=xxx
SUPABASE_ANON_KEY=xxx

# === Neon PostgreSQL (Source of Truth) ===
NEON_DATABASE_URL=xxx
NEON_DATABASE_TRANSACTION_POOLER=xxx

# === Turso SQLite (Edge Read Replica) ===
TURSO_DATABASE_URL=xxx
TURSO_AUTH_TOKEN=xxx

# === MongoDB (Audit Logs) ===
MONGODB_URI=xxx

# === Redis / Upstash (Rate Limiting) ===
UPSTASH_REDIS_REST_URL=xxx
UPSTASH_REDIS_REST_TOKEN=xxx

# === Cloudflare ===
CLOUDFLARE_KV_ID=xxx
CLOUDFLARE_D1_ID=xxx

# === API Keys ===
TMDB_API_KEY=xxx
TMDB_ACCESS_TOKEN=xxx
TMDB_BASE_URL=https://api.themoviedb.org/3
COMICVINE_API_KEY=xxx
GOOGLE_BOOKS_API_KEY=xxx
TWITCH_CLIENT_ID=xxx
TWITCH_CLIENT_SECRET=xxx
GUTENBERG_API_KEY=xxx

# === JWT ===
JWT_SECRET=xxx

# === Internal ===
INTERNAL_API_KEY=xxx
INTERNAL_API_URL=xxx

# === Environment ===
ENVIRONMENT=development
