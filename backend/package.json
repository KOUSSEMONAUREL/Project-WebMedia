{
  "name": "webmediia-backend",
  "version": "1.0.0",
  "description": "Backend API pour WebMediia - Plateforme de recommandations médias",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "start": "node dist/server.js",
    "build": "esbuild src/server.ts --bundle --platform=node --target=node24 --outfile=dist/server.js --format=esm --packages=external",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "test:db": "tsx test-db.ts"
  },
  "keywords": [
    "cloudflare",
    "workers",
    "hono",
    "api"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.6.26",
    "@hono/node-server": "^2.1.0",
    "@hono/zod-validator": "^0.9.0",
    "@libsql/client": "^0.17.4",
    "@supabase/supabase-js": "^2.112.2",
    "axios": "^1.19.0",
    "better-auth": "^1.6.26",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.1",
    "mongodb": "^7.5.0",
    "nodemailer": "^9.0.5",
    "postgres": "^3.4.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260801.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.1.2",
    "@types/nodemailer": "^8.0.1",
    "better-sqlite3": "^12.11.1",
    "drizzle-kit": "^0.31.10",
    "esbuild": "0.28.1",
    "tsx": "^4.23.11",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "wrangler": "^4.120.0"
  },
  "overrides": {
    "esbuild": "0.28.1",
    "ws": "^8.21.0",
    "undici": "^7.29.0"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true
  }
}
