{
  "name": "webmediia-backend",
  "version": "1.0.0",
  "description": "Backend API pour WebMediia - Plateforme de recommandations médias",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "start": "node dist/server.js",
    "build": "esbuild src/server.ts --bundle --platform=node --target=node24 --outfile=dist/server.js --format=esm --packages=external",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "test:db": "tsx test-db.ts"
  },
  "keywords": [
    "cloudflare",
    "workers",
    "hono",
    "api"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.18",
    "@hono/node-server": "^2.1.6",
    "@hono/zod-validator": "^0.9.1",
    "@libsql/client": "^0.18.0",
    "@supabase/supabase-js": "^2.119.0",
    "axios": "^1.21.0",
    "better-auth": "^1.7.18",
    "dotenv": "^18.0.9",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.16",
    "mongodb": "^7.8.0",
    "nodemailer": "^10.3.1",
    "postgres": "^4.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261106.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "better-sqlite3": "^12.11.1",
    "drizzle-kit": "^0.31.11",
    "esbuild": "0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0"
  },
  "overrides": {
    "esbuild": "0.28.2",
    "ws": "^8.21.0",
    "undici": "^7.29.0"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true
  }
}
