{
  "name": "import-worker",
  "version": "1.0.0",
  "description": "Worker pour l'import de données TMDB et synchronisation Turso",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "migrate:turso": "node dist/migrate-turso-identity.js",
    "backfill:igdb": "node dist/backfill-igdb-identity.js",
    "probe:igdb": "node dist/probe-igdb.js",
    "propagate:parents": "node dist/propagate-job-parents.js"
  },
  "dependencies": {
    "@fsoc/royalroadl-api": "^0.16.3",
    "@libsql/client": "^0.18.0",
    "axios": "^1.20.0",
    "dotenv": "^18.0.4",
    "drizzle-orm": "^0.45.3",
    "fast-xml-parser": "^5.11.1",
    "node-cron": "^4.6.0",
    "pg": "^8.23.0",
    "postgres": "^3.4.4",
    "tsx": "^4.23.15"
  },
  "devDependencies": {
    "@types/node": "^26.6.1",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
