---
export const prerender = true;
import Layout from '../layouts/Layout.astro';

const mainGenres = [
  "Action", "Aventure", "Comédie", "Drame", "Fantastique", 
  "Horreur", "Mystère", "Romance", "Science-Fiction", "Thriller",
  "Animation", "Documentaire", "Crime", "Famille"
];
---

<Layout title="Genres">
    <div class="container mx-auto px-6 py-10">
        <header class="mb-8 text-center">
            <h1 class="text-3xl md:text-4xl font-black italic uppercase tracking-tighter text-white inline-flex items-center gap-3"><svg class="w-6 h-6 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>EXPLORER PAR GENRES</h1>
            <p class="text-muted-foreground mt-1">Trouvez du contenu par catégorie selon vos envies.</p>
            <div class="w-16 h-0.5 bg-gradient-to-r from-transparent via-primary/50 to-transparent mx-auto mt-4" />
        </header>

        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4">
            {mainGenres.map((genre) => (
                <a 
                    href={`/genres/${genre.toLowerCase()}`}
                    class="group relative h-32 flex items-center justify-center rounded-xl bg-card border border-border overflow-hidden transition-all hover:border-primary hover:scale-[1.02]"
                >
                    <div class="absolute inset-0 bg-gradient-to-br from-primary/10 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
                    <span class="text-lg font-bold uppercase italic tracking-wider transition-colors group-hover:text-primary">
                        {genre}
                    </span>
                </a>
            ))}
        </div>
    </div>
</Layout>
