---
import Layout from '../layouts/Layout.astro';
import GenreCountGrid from '../components/GenreCountGrid';

---

<Layout title="Genres">
    <div class="container mx-auto px-6 py-10">
        <header class="mb-8 text-center">
            <h1 class="text-3xl md:text-4xl font-black italic uppercase tracking-tighter text-white">EXPLORER PAR GENRES</h1>
            <p class="text-muted-foreground mt-1">Trouvez du contenu par catégorie selon vos envies.</p>
            <div class="w-16 h-0.5 bg-gradient-to-r from-transparent via-primary/50 to-transparent mx-auto mt-4" />
        </header>

        <GenreCountGrid client:visible />
    </div>
</Layout>
