---
import Layout from '../layouts/Layout.astro';
import { MediaGrid } from '../components/MediaGrid';
import { DynamicHero } from '../components/DynamicHero';
import { getTrending, getMediaByType, type Media } from '../lib/api';

let trending: Media[] = [];
let popularFilms: Media[] = [];
let topSeries: Media[] = [];
let bestAnimes: Media[] = [];
let popularGames: Media[] = [];
let popularBooks: Media[] = [];
let topNovels: Media[] = [];

try {
  const [trendingRes, filmsRes, seriesRes, animesRes, gamesRes, booksRes, novelsRes] = await Promise.all([
    getTrending(),
    getMediaByType('film'),
    getMediaByType('serie'),
    getMediaByType('anime'),
    getMediaByType('jeu'),
    getMediaByType('book'),
    getMediaByType('novel'),
  ]);

  trending = trendingRes.data || [];
  popularFilms = filmsRes.data || [];
  topSeries = seriesRes.data || [];
  bestAnimes = animesRes.data || [];
  popularGames = gamesRes.data || [];
  popularBooks = booksRes.data || [];
  topNovels = novelsRes.data || [];
} catch (error) {
  console.error("Erreur lors du chargement des données sur l'accueil:", error);
}
---

<Layout title="Accueil">
    <DynamicHero client:load />

    <div class="max-w-7xl mx-auto px-4 sm:px-6 pb-12">
        <MediaGrid title="Recommandations" items={trending} minCards={8} size="large" client:load />

        <div class="flex flex-col items-center text-center pt-4 pb-12">
          <div class="flex items-center gap-4 flex-wrap justify-center">
            <a
              href="/trending"
              class="inline-flex items-center gap-2 font-semibold text-[14px] px-6 py-2.5 rounded-full text-primary-foreground shadow-lg transition-all duration-200 hover:scale-[1.03] active:scale-[0.98]"
              style="background:linear-gradient(135deg,#60a5fa 0%,#3b82f6 60%,#2563eb 100%);box-shadow:0 4px 24px rgba(59,130,246,0.3),0 1px 4px rgba(0,0,0,0.3)"
            >
              Explorer les tendances
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m9 18 6-6-6-6"/></svg>
            </a>
            <a
              href="/genres"
              class="inline-flex items-center gap-2 font-medium text-[14px] px-6 py-2.5 rounded-full text-foreground border border-border/60 bg-white/[0.04] hover:bg-white/[0.07] hover:border-primary/30 transition-all duration-200"
            >
              Parcourir par genre
            </a>
          </div>

          <div class="flex items-center gap-10 sm:gap-16 mt-10 text-center">
            <div class="flex flex-col items-center gap-1.5">
              <svg class="w-6 h-6 text-primary/70" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8M12 17v4"/></svg>
              <span class="text-3xl sm:text-4xl font-display font-bold" style="background:linear-gradient(135deg,#60a5fa 0%,#3b82f6 100%);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text">
                10 000+
              </span>
              <span class="text-[12px] text-muted-foreground font-medium tracking-wide uppercase">Titres</span>
            </div>
            <div class="flex flex-col items-center gap-1.5">
              <svg class="w-6 h-6 text-primary/70" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg>
              <span class="text-3xl sm:text-4xl font-display font-bold" style="background:linear-gradient(135deg,#60a5fa 0%,#3b82f6 100%);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text">
                8
              </span>
              <span class="text-[12px] text-muted-foreground font-medium tracking-wide uppercase">Categories</span>
            </div>
            <div class="flex flex-col items-center gap-1.5">
              <svg class="w-6 h-6 text-primary/70" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M12 2l2.4 7.2H22l-6 4.8 2.4 7.2L12 16l-6 4.8L8 14l-6-4.8h7.6z"/></svg>
              <span class="text-3xl sm:text-4xl font-display font-bold" style="background:linear-gradient(135deg,#60a5fa 0%,#3b82f6 100%);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text">
                Gratuit
              </span>
              <span class="text-[12px] text-muted-foreground font-medium tracking-wide uppercase">Acces</span>
            </div>
          </div>
        </div>

        <MediaGrid title="Films" items={popularFilms.slice(0, 10)} viewAllHref="/films" client:visible />
        <MediaGrid title="Séries" items={topSeries.slice(0, 10)} viewAllHref="/series" client:visible />
        <MediaGrid title="Animés" items={bestAnimes.slice(0, 10)} viewAllHref="/animes" client:visible />
        <MediaGrid title="Jeux" items={popularGames.slice(0, 10)} viewAllHref="/games" client:visible />
        <MediaGrid title="Livres" items={popularBooks.slice(0, 10)} viewAllHref="/books" client:visible />
        <MediaGrid title="Light Novels" items={topNovels.slice(0, 10)} viewAllHref="/novels" client:visible />
    </div>
</Layout>
