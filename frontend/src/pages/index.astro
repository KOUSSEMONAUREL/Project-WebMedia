---
import Layout from '../layouts/Layout.astro';
import { MediaGrid } from '../components/MediaGrid';
import { getTrending, getMediaByType, type Media } from '../lib/api';

// Fetch data from API (which falls back to mockData internally if backend is down)
let trending: Media[] = [];
let popularFilms: Media[] = [];
let topSeries: Media[] = [];
let bestAnimes: Media[] = [];
let popularBooks: Media[] = [];
let topNovels: Media[] = [];

try {
  const [trendingRes, filmsRes, seriesRes, animesRes, booksRes, novelsRes] = await Promise.all([
    getTrending(),
    getMediaByType('film'),
    getMediaByType('serie'),
    getMediaByType('anime'),
    getMediaByType('book'),
    getMediaByType('novel'),
  ]);

  trending = trendingRes.data || [];
  popularFilms = filmsRes.data || [];
  topSeries = seriesRes.data || [];
  bestAnimes = animesRes.data || [];
  popularBooks = booksRes.data || [];
  topNovels = novelsRes.data || [];
} catch (error) {
  console.error("Erreur lors du chargement des données sur l'accueil:", error);
}
---

<Layout title="Accueil">
    <div class="container mx-auto px-6 pt-20 pb-16">
        <header class="mb-16 relative w-full max-w-6xl mx-auto rounded-3xl overflow-hidden border border-border shadow-2xl py-24 px-6 flex flex-col items-center text-center group">
            <div class="absolute inset-0 z-0 pointer-events-none bg-black">
                <img src="/images/server-room.png" alt="Serveurs WebMedia" class="w-full h-full object-cover transform group-hover:scale-105 transition-transform duration-1000 opacity-50 mix-blend-luminosity" />
                <div class="absolute inset-0 bg-gradient-to-b from-background/20 via-background/60 to-background"></div>
                <div class="absolute inset-0 bg-gradient-to-t from-background/20 via-background/60 to-background"></div>
            </div>
            
            <div class="relative z-10 space-y-6 flex flex-col items-center">
                <div class="relative">
                    <div class="absolute inset-0 bg-primary/20 blur-3xl rounded-full w-96 h-32 -top-6 left-1/2 -translate-x-1/2" />
                    <h1 class="relative text-2xl sm:text-4xl md:text-5xl lg:text-6xl font-display font-semibold text-white leading-tight">
                        Tout le divertissement, <br class="md:hidden" /><span class="text-primary italic drop-shadow-md">un seul endroit.</span>
                    </h1>
                </div>
                <p class="text-gray-200 max-w-lg text-lg font-medium drop-shadow-lg">
                    Films, séries, animés, jeux, livres & light novels — votre bibliothèque ultime.
                </p>
                <div class="w-24 h-1 mt-6 bg-gradient-to-r from-transparent via-primary to-transparent rounded-full shadow-[0_0_15px_rgba(212,175,55,0.6)]" />
            </div>
        </header>

        <MediaGrid title="Tendances du moment" items={trending} viewAllHref="/trending" client:load />
        <MediaGrid title="Films Populaires" items={popularFilms} viewAllHref="/films" client:load />
        <MediaGrid title="Séries à ne pas manquer" items={topSeries} viewAllHref="/series" client:load />
        <MediaGrid title="Top Animés" items={bestAnimes} viewAllHref="/animes" client:load />
        <MediaGrid title="Livres Populaires" items={popularBooks} viewAllHref="/books" client:load />
        <MediaGrid title="Light Novels" items={topNovels} viewAllHref="/novels" client:load />
    </div>
</Layout>
