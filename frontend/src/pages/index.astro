---
import Layout from '../layouts/Layout.astro';
import { MediaGrid } from '../components/MediaGrid';
import { TrendingCarousel } from '../components/TrendingCarousel';
import { DynamicHero } from '../components/DynamicHero';
import { getTrending, getMediaByType, type Media } from '../lib/api';

let trending: Media[] = [];
let popularFilms: Media[] = [];
let topSeries: Media[] = [];
let bestAnimes: Media[] = [];
let popularGames: Media[] = [];
let popularBooks: Media[] = [];
let topNovels: Media[] = [];

try {
  const [trendingRes, filmsRes, seriesRes, animesRes, gamesRes, booksRes, novelsRes] = await Promise.all([
    getTrending(),
    getMediaByType('film'),
    getMediaByType('serie'),
    getMediaByType('anime'),
    getMediaByType('jeu'),
    getMediaByType('book'),
    getMediaByType('novel'),
  ]);

  trending = trendingRes.data || [];
  popularFilms = filmsRes.data || [];
  topSeries = seriesRes.data || [];
  bestAnimes = animesRes.data || [];
  popularGames = gamesRes.data || [];
  popularBooks = booksRes.data || [];
  topNovels = novelsRes.data || [];
} catch (error) {
  console.error("Erreur lors du chargement des données sur l'accueil:", error);
}

Astro.response.headers.set(
  'Cache-Control',
  's-maxage=54000, stale-while-revalidate=1800'
);

---

<Layout title="WebMediia">
    <DynamicHero client:load />

    <div class="max-w-7xl mx-auto px-4 sm:px-6 pb-12">
        <TrendingCarousel items={trending} client:load />

        <MediaGrid title="Films" mediaType="film" items={popularFilms.slice(0, 10)} viewAllHref="/films" client:visible />
        <MediaGrid title="Séries" mediaType="serie" items={topSeries.slice(0, 10)} viewAllHref="/series" client:visible />
        <MediaGrid title="Animés" mediaType="anime" items={bestAnimes.slice(0, 10)} viewAllHref="/animes" client:visible />

        <MediaGrid title="Jeux" mediaType="jeu" items={popularGames.slice(0, 10)} viewAllHref="/games" client:visible />
        <MediaGrid title="Livres" mediaType="book" items={popularBooks.slice(0, 10)} viewAllHref="/books" client:visible />
        <MediaGrid title="Light Novels" mediaType="novel" items={topNovels.slice(0, 10)} viewAllHref="/novels" client:visible />
    </div>
</Layout>
