---
import Layout from '../layouts/Layout.astro';
import { MediaGrid } from '../components/MediaGrid';
import { DynamicHero } from '../components/DynamicHero';
import { getMediaByType, type Media } from '../lib/api';

let animes: Media[] = [];
try {
  const res = await getMediaByType('anime');
  animes = res.data || [];
} catch {}
---

<Layout title="Animés">
  <div class="container mx-auto px-6 py-10">
    <DynamicHero 
        client:load 
        defaultTitle="Animés" 
        defaultSubtitle="Le meilleur de l'animation japonaise. Épopées épiques, récits intimistes, univers infinis."
    />
    <MediaGrid title="Animés" items={animes} client:load />
  </div>
</Layout>
