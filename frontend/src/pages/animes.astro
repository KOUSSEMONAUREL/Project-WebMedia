---
import Layout from '../layouts/Layout.astro';
import { getMediaByType, type Media } from '../lib/api';

let animes: Media[] = [];
try {
  const res = await getMediaByType('anime');
  animes = res.data || [];
} catch {}
---

<Layout title="Animés">
  <div class="relative overflow-hidden">
    <!-- Hero section -->
    <div class="relative pt-20 pb-16 md:pt-28 md:pb-20 bg-gradient-to-b from-pink-950/60 via-background to-background">
      <div class="absolute inset-0 overflow-hidden pointer-events-none">
        <div class="absolute top-10 right-10 w-64 h-64 bg-pink-500/10 rounded-full blur-3xl" />
        <div class="absolute -bottom-10 left-1/3 w-80 h-80 bg-rose-500/5 rounded-full blur-3xl" />
      </div>
      <div class="container mx-auto px-6 relative">
        <div class="flex flex-col md:flex-row items-center gap-8 md:gap-16">
          <div class="flex-shrink-0">
            <div class="w-28 h-28 md:w-36 md:h-36 rounded-2xl bg-gradient-to-br from-pink-500 to-rose-600 flex items-center justify-center shadow-2xl shadow-pink-500/30">
              <svg class="w-14 h-14 md:w-20 md:h-20 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/>
              </svg>
            </div>
          </div>
          <div class="text-center md:text-left">
            <h1 class="text-5xl md:text-7xl lg:text-8xl font-display font-bold text-white leading-tight">
              <span class="text-pink-400 italic">ANIMÉS</span>
            </h1>
            <p class="mt-3 text-lg md:text-xl text-muted-foreground max-w-xl font-light">
              Le meilleur de l'animation japonaise. Épopées épiques, récits intimistes, univers infinis.
            </p>
            <div class="mt-6 flex flex-wrap gap-3 justify-center md:justify-start">
              <span class="px-4 py-1.5 bg-pink-500/20 text-pink-300 rounded-full text-sm border border-pink-500/30">Shōnen</span>
              <span class="px-4 py-1.5 bg-pink-500/20 text-pink-300 rounded-full text-sm border border-pink-500/30">Seinen</span>
              <span class="px-4 py-1.5 bg-pink-500/20 text-pink-300 rounded-full text-sm border border-pink-500/30">Isekai</span>
              <span class="px-4 py-1.5 bg-pink-500/20 text-pink-300 rounded-full text-sm border border-pink-500/30">Slice of Life</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Grid section avec style animé -->
    <div class="container mx-auto px-6 pb-16">
      <div class="border-l-4 border-pink-500 pl-4 mb-10">
        <p class="text-sm text-pink-400 font-medium uppercase tracking-widest">Catalogue</p>
        <h2 class="text-2xl font-display font-semibold text-white">Tous les animés</h2>
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 gap-6 md:gap-8">
        {animes.length > 0 ? animes.map((m) => (
          <a href={`/${m.type}/${m.slug}`} class="group flex flex-col gap-3 transition-all duration-500 hover:-translate-y-2">
            <div class="relative aspect-[2/3] w-full overflow-hidden rounded-xl shadow-lg border border-white/5 group-hover:shadow-pink-500/20 group-hover:shadow-2xl transition-all duration-500">
              <img src={m.posterUrl} alt={m.title} class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105" loading="lazy" onerror="this.src='https://via.placeholder.com/300x450?text=?'" />
              <div class="absolute top-2 right-2 bg-black/60 backdrop-blur px-2 py-0.5 rounded text-yellow-500 text-xs font-bold flex items-center gap-1">
                <svg class="w-3 h-3 fill-current" viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                {m.rating}
              </div>
            </div>
            <h3 class="font-display font-semibold text-base text-foreground group-hover:text-pink-400 transition-colors line-clamp-2">{m.title}</h3>
            <p class="text-xs text-muted-foreground">{m.year}</p>
          </a>
        )) : (
          <div class="col-span-full py-20 text-center text-muted-foreground">Aucun animé trouvé.</div>
        )}
      </div>
    </div>
  </div>
</Layout>
