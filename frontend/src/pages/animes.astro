---
import Layout from '../layouts/Layout.astro';
import { MediaGrid } from '../components/MediaGrid';
import { getMediaByType, type Media } from '../lib/api';

let animes: Media[] = [];
try {
  const res = await getMediaByType('anime');
  animes = res.data || [];
} catch {}
---

<Layout title="Animés">
  <div class="container mx-auto px-6 py-10">
    <header class="mb-8 text-center">
      <h1 class="text-3xl md:text-4xl font-display font-bold text-white inline-flex items-center gap-3"><svg class="w-6 h-6 text-orange-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"/></svg>Animés</h1>
      <p class="text-muted-foreground mt-1">Le meilleur de l'animation japonaise. Épopées épiques, récits intimistes, univers infinis.</p>
      <div class="w-16 h-0.5 bg-gradient-to-r from-transparent via-orange-500/50 to-transparent mx-auto mt-4" />
    </header>
    <MediaGrid title="Animés" items={animes} />
  </div>
</Layout>
