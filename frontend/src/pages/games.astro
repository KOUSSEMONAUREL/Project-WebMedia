---
import Layout from '../layouts/Layout.astro';
import { MediaGrid } from '../components/MediaGrid';
import { DynamicHero } from '../components/DynamicHero';
import { getMediaByType, type Media } from '../lib/api';

let games: Media[] = [];
try {
  const res = await getMediaByType('jeu');
  games = res.data || [];
} catch {}
---

<Layout title="Jeux Vidéo">
  <div class="container mx-auto px-6 py-10">
    <DynamicHero 
        client:load 
        defaultTitle="Jeux Vidéo" 
        defaultSubtitle="Le divertissement interactif. Explorez, créez, combattez — le jeu sous toutes ses formes."
    />
    <MediaGrid title="Jeux Vidéo" items={games} client:load />
  </div>
</Layout>
