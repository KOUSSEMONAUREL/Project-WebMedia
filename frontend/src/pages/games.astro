---
import Layout from '../layouts/Layout.astro';
import { getMediaByType, type Media } from '../lib/api';

let games: Media[] = [];
try {
  const res = await getMediaByType('jeu');
  games = res.data || [];
} catch {}
---

<Layout title="Jeux Vidéo">
  <div class="relative overflow-hidden">
    <!-- Hero section -->
    <div class="relative pt-20 pb-16 md:pt-28 md:pb-20 bg-gradient-to-b from-green-950/60 via-background to-background">
      <div class="absolute inset-0 overflow-hidden pointer-events-none">
        <div class="absolute top-20 -right-20 w-80 h-80 bg-green-500/10 rounded-full blur-3xl" />
        <div class="absolute -bottom-20 left-20 w-60 h-60 bg-emerald-500/5 rounded-full blur-3xl" />
      </div>
      <div class="container mx-auto px-6 relative">
        <div class="flex flex-col md:flex-row items-center gap-8 md:gap-16">
          <div class="flex-shrink-0">
            <div class="w-28 h-28 md:w-36 md:h-36 rounded-2xl bg-gradient-to-br from-green-500 to-emerald-600 flex items-center justify-center shadow-2xl shadow-green-500/30">
              <svg class="w-14 h-14 md:w-20 md:h-20 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <line x1="6" y1="12" x2="10" y2="12"/>
                <line x1="8" y1="10" x2="8" y2="14"/>
                <circle cx="15" cy="13" r="1"/>
                <circle cx="18" cy="11" r="1"/>
                <rect x="2" y="6" width="20" height="12" rx="2"/>
              </svg>
            </div>
          </div>
          <div class="text-center md:text-left">
            <h1 class="text-5xl md:text-7xl lg:text-8xl font-display font-bold text-white leading-tight">
              <span class="text-green-400 italic">JEUX VIDÉO</span>
            </h1>
            <p class="mt-3 text-lg md:text-xl text-muted-foreground max-w-xl font-light">
              Le divertissement interactif. Explorez, créez, combattez — le jeu sous toutes ses formes.
            </p>
            <div class="mt-6 flex flex-wrap gap-3 justify-center md:justify-start">
              <span class="px-4 py-1.5 bg-green-500/20 text-green-300 rounded-full text-sm border border-green-500/30">RPG</span>
              <span class="px-4 py-1.5 bg-green-500/20 text-green-300 rounded-full text-sm border border-green-500/30">Action</span>
              <span class="px-4 py-1.5 bg-green-500/20 text-green-300 rounded-full text-sm border border-green-500/30">Aventure</span>
              <span class="px-4 py-1.5 bg-green-500/20 text-green-300 rounded-full text-sm border border-green-500/30">Open World</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Grid section avec style jeu vidéo -->
    <div class="container mx-auto px-6 pb-16">
      <div class="border-l-4 border-green-500 pl-4 mb-10">
        <p class="text-sm text-green-400 font-medium uppercase tracking-widest">Catalogue</p>
        <h2 class="text-2xl font-display font-semibold text-white">Tous les jeux</h2>
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 gap-6 md:gap-8">
        {games.length > 0 ? games.map((m) => (
          <a href={`/${m.type}/${m.slug}`} class="group flex flex-col gap-3 transition-all duration-500 hover:-translate-y-2">
            <div class="relative aspect-[2/3] w-full overflow-hidden rounded-xl shadow-lg border border-white/5 group-hover:shadow-green-500/20 group-hover:shadow-2xl transition-all duration-500">
              <img src={m.posterUrl} alt={m.title} class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105" loading="lazy" onerror="this.src='https://via.placeholder.com/300x450?text=?'" />
              <div class="absolute top-2 right-2 bg-black/60 backdrop-blur px-2 py-0.5 rounded text-yellow-500 text-xs font-bold flex items-center gap-1">
                <svg class="w-3 h-3 fill-current" viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                {m.rating}
              </div>
            </div>
            <h3 class="font-display font-semibold text-base text-foreground group-hover:text-green-400 transition-colors line-clamp-2">{m.title}</h3>
            <p class="text-xs text-muted-foreground">{m.year}</p>
          </a>
        )) : (
          <div class="col-span-full py-20 text-center text-muted-foreground">Aucun jeu trouvé.</div>
        )}
      </div>
    </div>
  </div>
</Layout>
