---
import Layout from '../layouts/Layout.astro';
import { CategoryGrid } from '../components/CategoryGrid';
import { getMediaByType } from '../lib/api';

let initialData: any[] = [];
let initialTotal = 0;
try {
  const result = await getMediaByType('jeu', { limit: 20, sort: 'created_at', order: 'desc' });
  initialData = result.data || [];
  initialTotal = result.total || 0;
} catch (e) {
  console.error('[games] SSR error:', e);
}
---

<Layout title="Jeux Video" description="Tous les jeux video disponibles sur WebMediia. Classement et filtres." canonicalUrl="https://www.webmediia.cfd/games">
  <CategoryGrid type="jeu" title="Jeux Video" client:visible initialData={initialData} initialTotal={initialTotal} />
</Layout>
