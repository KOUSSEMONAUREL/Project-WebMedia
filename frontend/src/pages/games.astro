---
import Layout from '../layouts/Layout.astro';
import { MediaGrid } from '../components/MediaGrid';
import { getMediaByType, type Media } from '../lib/api';

let games: Media[] = [];
try {
  const res = await getMediaByType('jeu');
  games = res.data || [];
} catch {}
---

<Layout title="Jeux Vidéo">
  <div class="container mx-auto px-6 py-10">
    <header class="mb-8 text-center">
      <h1 class="text-3xl md:text-4xl font-display font-bold text-white inline-flex items-center gap-3"><svg class="w-6 h-6 text-green-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="6" width="20" height="12" rx="2"/><circle cx="15" cy="13" r="1"/><circle cx="18" cy="11" r="1"/></svg>Jeux Vidéo</h1>
      <p class="text-muted-foreground mt-1">Le divertissement interactif. Explorez, créez, combattez — le jeu sous toutes ses formes.</p>
      <div class="w-16 h-0.5 bg-gradient-to-r from-transparent via-green-500/50 to-transparent mx-auto mt-4" />
    </header>
    <MediaGrid title="Jeux Vidéo" items={games} />
  </div>
</Layout>
