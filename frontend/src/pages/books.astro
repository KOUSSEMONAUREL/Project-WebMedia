---
import Layout from '../layouts/Layout.astro';
import { CategoryGrid } from '../components/CategoryGrid';
import { getMediaByType } from '../lib/api';

let initialData: any[] = [];
let initialTotal = 0;
try {
  const result = await getMediaByType('book', { limit: 20, sort: 'created_at', order: 'desc' });
  initialData = result.data || [];
  initialTotal = result.total || 0;
} catch (e) {
  console.error('[books] SSR error:', e);
}
---

<Layout title="Livres" description="Decouvrez tous les livres disponibles sur WebMediia. Classement et filtres." canonicalUrl="https://www.webmediia.cfd/books">
  <CategoryGrid type="book" title="Livres" client:visible initialData={initialData} initialTotal={initialTotal} />
</Layout>
