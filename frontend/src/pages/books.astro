---
import Layout from '../layouts/Layout.astro';
import { MediaGrid } from '../components/MediaGrid';
import { getMediaByType, type Media } from '../lib/api';

let books: Media[] = [];
try {
  const res = await getMediaByType('book');
  books = res.data || [];
} catch {}
---

<Layout title="Livres">
  <div class="container mx-auto px-6 py-10">
    <header class="mb-8 text-center">
      <h1 class="text-3xl md:text-4xl font-display font-bold text-white inline-flex items-center gap-3"><svg class="w-6 h-6 text-amber-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>Livres</h1>
      <p class="text-muted-foreground mt-1">Des mots qui façonnent des mondes. Plongez dans la littérature, du classique à la fantasy.</p>
      <div class="w-16 h-0.5 bg-gradient-to-r from-transparent via-amber-500/50 to-transparent mx-auto mt-4" />
    </header>
    <MediaGrid title="Livres" items={books} />
  </div>
</Layout>
