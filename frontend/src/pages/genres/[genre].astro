---
import Layout from '../../layouts/Layout.astro';

export function getStaticPaths() {
  const genres = ["action", "aventure", "comedie", "drame", "fantastique", "horreur", "mystere", "romance", "science-fiction", "thriller", "animation", "documentaire", "crime", "famille", "western", "rpg", "arts-martiaux"];
  return genres.map(g => ({ params: { genre: g } }));
}

const { genre } = Astro.params;
const displayName = genre ? genre.charAt(0).toUpperCase() + genre.slice(1).replace(/-/g, ' ') : '';

const typeRedirects: Record<string, string> = {
  action: '/films', aventure: '/films', comedie: '/films',
  drame: '/films', fantastique: '/animes', horreur: '/films',
  mystere: '/series', romance: '/novels', 'science-fiction': '/films',
  thriller: '/films', animation: '/animes', documentaire: '/films',
  crime: '/series', famille: '/films', western: '/films',
  rpg: '/games', 'arts-martiaux': '/animes',
};
const redirect = typeRedirects[genre || ''] || '/genres';
---

<Layout title={displayName}>
  <div class="container mx-auto px-6 py-20 text-center">
    <h1 class="text-3xl font-display font-bold text-white mb-4">{displayName}</h1>
    <p class="text-muted-foreground mb-8">Les pages genres sont momentanement indisponibles.</p>
    <p class="text-muted-foreground mb-8">Utilisez les categories pour naviguer parmi les contenus.</p>
    <a href={redirect} class="inline-flex items-center gap-2 px-6 py-3 rounded-xl bg-primary text-primary-foreground font-bold hover:opacity-90 transition-opacity">
      Voir les {redirect === '/films' ? 'films' : redirect === '/series' ? 'series' : redirect === '/animes' ? 'animes' : redirect === '/games' ? 'jeux' : redirect === '/novels' ? 'novels' : 'contenus'}
    </a>
    <a href="/genres" class="inline-flex items-center gap-2 px-6 py-3 ml-3 rounded-xl bg-white/10 text-white font-bold hover:bg-white/20 transition-colors">
      Tous les genres
    </a>
  </div>
</Layout>
