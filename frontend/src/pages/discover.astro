---
import Layout from '../layouts/Layout.astro';
import { MediaGrid } from '../components/MediaGrid';
import { getTrending, getMediaByType, type Media } from '../lib/api';

let trending: Media[] = [];
let films: Media[] = [];
let series: Media[] = [];
let animes: Media[] = [];
let games: Media[] = [];
let webtoons: Media[] = [];
let books: Media[] = [];
let novels: Media[] = [];

try {
  const [tr, fr, sr, ar, gr, wr, br, nr] = await Promise.all([
    getTrending(),
    getMediaByType('film'),
    getMediaByType('serie'),
    getMediaByType('anime'),
    getMediaByType('jeu'),
    getMediaByType('webtoon'),
    getMediaByType('book'),
    getMediaByType('novel'),
  ]);
  trending = tr.data || [];
  films = fr.data || [];
  series = sr.data || [];
  animes = ar.data || [];
  games = gr.data || [];
  webtoons = wr.data || [];
  books = br.data || [];
  novels = nr.data || [];
} catch {}
---

<Layout title="Découvrir">
  <div class="container mx-auto px-6 pt-28 pb-16">
    <header class="mb-8 text-center">
      <h1 class="text-3xl md:text-4xl font-display font-bold text-white inline-flex items-center gap-3"><svg class="w-6 h-6 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polygon points="16.24 7.76 14.12 14.12 7.76 16.24 9.88 9.88 16.24 7.76"/></svg>Découvrir</h1>
      <p class="text-muted-foreground mt-1">Explorez tous les contenus disponibles sur WebMedia.</p>
      <div class="w-16 h-0.5 bg-gradient-to-r from-transparent via-primary/50 to-transparent mx-auto mt-4" />
    </header>

    <MediaGrid title="Tendances" items={trending} viewAllHref="/trending" client:load />
    <MediaGrid title="Films" items={films} viewAllHref="/films" client:load />
    <MediaGrid title="Séries" items={series} viewAllHref="/series" client:load />
    <MediaGrid title="Animés" items={animes} viewAllHref="/animes" client:load />
    <MediaGrid title="Jeux Vidéo" items={games} viewAllHref="/games" client:load />
    <MediaGrid title="Webtoons" items={webtoons} viewAllHref="/webtoons" client:load />
    <MediaGrid title="Livres" items={books} viewAllHref="/books" client:load />
    <MediaGrid title="Light Novels" items={novels} viewAllHref="/novels" client:load />
  </div>
</Layout>
