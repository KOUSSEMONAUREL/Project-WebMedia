---
export const prerender = true;
import GridPage from '../components/GridPage.astro';
import { getTrending, type Media } from '../lib/api';

let trending: Media[] = [];
try {
  const res = await getTrending();
  trending = res.data || [];
} catch {}
---

<GridPage title="Tendances" items={trending} pageTitle="Tendances" description="Les contenus les plus populaires du moment." />
