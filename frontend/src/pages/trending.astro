---
import Layout from '../layouts/Layout.astro';
import { MediaGrid } from '../components/MediaGrid';
import { getTrending, type Media } from '../lib/api';

let trending: Media[] = [];
try {
  const res = await getTrending();
  trending = res.data || [];
} catch {}
---

<Layout title="Tendances">
  <div class="container mx-auto px-6 py-10">
    <header class="mb-8 text-center">
      <h1 class="text-3xl md:text-4xl font-display font-bold text-white inline-flex items-center gap-3"><svg class="w-6 h-6 text-primary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="23 6 13.5 15.5 8.5 10.5 1 18"/><polyline points="17 6 23 6 23 12"/></svg>TENDANCES</h1>
      <p class="text-muted-foreground mt-1">Les contenus les plus populaires du moment.</p>
      <div class="w-16 h-0.5 bg-gradient-to-r from-transparent via-primary/50 to-transparent mx-auto mt-4" />
    </header>
    <MediaGrid title="Tendances du moment" items={trending} client:load />
  </div>
</Layout>
