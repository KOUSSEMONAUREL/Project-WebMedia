---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page introuvable" canonicalUrl={Astro.url.href}>
  <div class="container mx-auto px-6 py-24 text-center">
    <h1 class="text-6xl font-display font-bold mb-4" style="background:linear-gradient(135deg,#93c5fd,#60a5fa);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text">
      404
    </h1>
    <p class="text-xl text-muted-foreground mb-2">Page introuvable</p>
    <p class="text-sm text-muted-foreground/60 mb-8">
      La page que vous cherchez n'existe pas ou a ete deplacee.
    </p>
    <a href="/" class="inline-flex items-center gap-2 px-6 py-3 rounded-full text-sm font-semibold text-white transition-all duration-200 hover:scale-[1.03] active:scale-[0.98]"
       style="background:linear-gradient(135deg,#60a5fa 0%,#3b82f6 60%,#2563eb 100%)">
      <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m15 18-6-6 6-6"/></svg>
      Retour a l'accueil
    </a>
  </div>
</Layout>
