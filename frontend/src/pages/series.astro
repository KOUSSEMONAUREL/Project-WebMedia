---
import Layout from '../layouts/Layout.astro';
import { MediaGrid } from '../components/MediaGrid';
import { getMediaByType, type Media } from '../lib/api';

let series: Media[] = [];
try {
  const res = await getMediaByType('serie');
  series = res.data || [];
} catch {}
---

<Layout title="Séries">
  <div class="container mx-auto px-6 py-10">
    <header class="mb-8 text-center">
      <h1 class="text-3xl md:text-4xl font-display font-bold text-white inline-flex items-center gap-3"><svg class="w-6 h-6 text-purple-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="7" width="20" height="15" rx="2"/><polyline points="17 2 12 7 7 2"/></svg>Séries</h1>
      <p class="text-muted-foreground mt-1">Des histoires qui durent. Plongez dans des univers captivants, saison après saison.</p>
      <div class="w-16 h-0.5 bg-gradient-to-r from-transparent via-purple-500/50 to-transparent mx-auto mt-4" />
    </header>
    <MediaGrid title="Séries" items={series} />
  </div>
</Layout>
