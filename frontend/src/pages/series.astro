---
import Layout from '../layouts/Layout.astro';
import { CategoryGrid } from '../components/CategoryGrid';
import { getMediaByType } from '../lib/api';

let initialData: any[] = [];
let initialTotal = 0;
try {
  const result = await getMediaByType('serie', { limit: 20, sort: 'created_at', order: 'desc' });
  initialData = result.data || [];
  initialTotal = result.total || 0;
} catch (e) {
  console.error('[series] SSR error:', e);
}
---

<Layout title="Series" description="Toutes les series disponibles sur WebMediia. Streaming gratuit, classement et filtres." canonicalUrl="https://www.webmediia.cfd/series">
  <CategoryGrid type="serie" title="Series" client:visible initialData={initialData} initialTotal={initialTotal} />
</Layout>
