---
import Layout from '../layouts/Layout.astro';
import { MediaGrid } from '../components/MediaGrid';
import { getMediaByType, type Media } from '../lib/api';

let novels: Media[] = [];
try {
  const res = await getMediaByType('novel');
  novels = res.data || [];
} catch {}
---

<Layout title="Light Novels">
  <div class="container mx-auto px-6 py-10">
    <header class="mb-8 text-center">
      <h1 class="text-3xl md:text-4xl font-display font-bold text-white inline-flex items-center gap-3"><svg class="w-6 h-6 text-teal-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/><line x1="8" y1="7" x2="16" y2="7"/><line x1="8" y1="11" x2="14" y2="11"/></svg>Light Novels</h1>
      <p class="text-muted-foreground mt-1">Romans japonais illustrés. Des séries addictives entre littérature et manga.</p>
      <div class="w-16 h-0.5 bg-gradient-to-r from-transparent via-teal-500/50 to-transparent mx-auto mt-4" />
    </header>
    <MediaGrid title="Light Novels" items={novels} />
  </div>
</Layout>
