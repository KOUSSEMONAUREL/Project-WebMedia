---
import Layout from '../layouts/Layout.astro';
import { CategoryGrid } from '../components/CategoryGrid';
import { getMediaByType } from '../lib/api';

let initialData: any[] = [];
let initialTotal = 0;
try {
  const result = await getMediaByType('novel', { limit: 20, sort: 'created_at', order: 'desc' });
  initialData = result.data || [];
  initialTotal = result.total || 0;
} catch (e) {
  console.error('[novels] SSR error:', e);
}
---

<Layout title="Light Novels" description="Tous les light novels disponibles sur WebMediia. Classement et filtres." canonicalUrl="https://www.webmediia.cfd/novels">
  <CategoryGrid type="novel" title="Light Novels" client:visible initialData={initialData} initialTotal={initialTotal} />
</Layout>
