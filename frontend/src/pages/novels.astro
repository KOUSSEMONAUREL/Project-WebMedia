---
import Layout from '../layouts/Layout.astro';
import { MediaGrid } from '../components/MediaGrid';
import { PageHeader } from '../components/PageHeader';
import { getMediaByType, type Media } from '../lib/api';

let novels: Media[] = [];
try {
  const res = await getMediaByType('novel');
  novels = res.data || [];
} catch {}
---

<Layout title="Light Novels">
  <div class="container mx-auto px-6 py-10">
    <PageHeader title="Light Novels" subtitle="Romans japonais illustrés. Des séries addictives entre littérature et manga." />
    <MediaGrid title="Light Novels" items={novels} client:load />
  </div>
</Layout>
