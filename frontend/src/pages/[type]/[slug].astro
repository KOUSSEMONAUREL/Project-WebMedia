---
import Layout from '../../layouts/Layout.astro';
import { getMediaDetails, getMediaByType, type Media } from '../../lib/api';

export async function getStaticPaths() {
  const types = ['film', 'serie', 'anime', 'jeu', 'webtoon', 'book', 'novel'];
  let paths: { params: { type: string; slug: string } }[] = [];

  for (const t of types) {
    try {
      const res = await getMediaByType(t);
      if (res.data) {
        const typePaths = res.data.map(media => ({
          params: { type: media.type, slug: media.slug || media.id }
        }));
        paths = [...paths, ...typePaths];
      }
    } catch {
      console.log(`Erreur lors de la generation des chemins pour ${t}`);
    }
  }

  return paths;
}

const { type, slug } = Astro.params;

let media: Media | null = null;
let error: string | null = null;

try {
  const response = await getMediaDetails(type!, slug!);
  if (response.success && response.data) {
    media = response.data;
  } else {
    error = "Media non trouve.";
  }
} catch (e: any) {
  error = e.message || "Erreur lors du chargement des details.";
}

const isEpisodeBased = media?.type === 'serie' || media?.type === 'anime';
const hasEpisodes = isEpisodeBased && (media?.episodes?.length ?? 0) > 0;
const hasLinks = (media?.links?.length ?? 0) > 0;

const typeLabels: Record<string, string> = {
  film: 'FILM', serie: 'SERIE', anime: 'ANIME', jeu: 'JEU',
  webtoon: 'WEBTOON', book: 'LIVRE', novel: 'NOVEL',
};

const heroGradients: Record<string, string> = {
  film: 'from-sky-700/60 via-sky-900/30 to-background',
  serie: 'from-violet-700/60 via-violet-900/30 to-background',
  anime: 'from-rose-700/60 via-rose-900/30 to-background',
  jeu: 'from-emerald-700/60 via-emerald-900/30 to-background',
  webtoon: 'from-amber-700/60 via-amber-900/30 to-background',
  book: 'from-orange-700/60 via-orange-900/30 to-background',
  novel: 'from-teal-700/60 via-teal-900/30 to-background',
};

const placeholderGradients: Record<string, string> = {
  film: 'from-sky-950/80 via-sky-900/40 to-card',
  serie: 'from-violet-950/80 via-violet-900/40 to-card',
  anime: 'from-rose-950/80 via-rose-900/40 to-card',
  jeu: 'from-emerald-950/80 via-emerald-900/40 to-card',
  webtoon: 'from-amber-950/80 via-amber-900/40 to-card',
  book: 'from-orange-950/80 via-orange-900/40 to-card',
  novel: 'from-teal-950/80 via-teal-900/40 to-card',
};

const heroGrad = heroGradients[media?.type] || 'from-gray-700/60 to-background';
const placeholderGrad = placeholderGradients[media?.type] || 'from-card to-secondary/80';
const scriptData = media ? { id: media.id, type: media.type, title: media.title, slug: media.slug, posterUrl: media.posterUrl, year: media.year, rating: media.rating } : null;
---

<Layout title={media ? media.title : 'Details'}>
  {error ? (
    <div class="container mx-auto px-6 py-20 text-center">
      <h1 class="text-4xl text-red-500 font-bold mb-4">Erreur</h1>
      <p class="text-white text-lg">{error}</p>
      <a href="/" class="text-primary mt-6 inline-block hover:underline">Retour a l'accueil</a>
    </div>
  ) : media ? (
    <div class="relative min-h-screen">

      {/* Hero Background */}
      <div class="absolute inset-0 z-0 h-[70vh] w-full overflow-hidden">
        <div class={`absolute inset-0 bg-gradient-to-b ${heroGrad} z-10`}></div>
        <div class="absolute inset-0 bg-gradient-to-t from-background via-background/70 to-transparent z-10"></div>
        {media.posterUrl ? (
          <img src={media.posterUrl} alt={media.title} class="w-full h-full object-cover opacity-30" />
        ) : (
          <div class="w-full h-full">
            <div class={`absolute inset-0 bg-gradient-to-br ${placeholderGrad}`}></div>
            <div class="absolute top-1/4 left-1/3 w-96 h-96 rounded-full bg-white/[0.02] blur-3xl"></div>
            <div class="absolute bottom-1/4 right-1/4 w-64 h-64 rounded-full bg-white/[0.015] blur-2xl"></div>
          </div>
        )}
      </div>

      {/* Content */}
      <div class="container relative z-10 mx-auto px-6 pt-28 pb-20">
        <div class="flex flex-col md:flex-row gap-10 md:gap-16 items-start">

          {/* Poster */}
          <div class="w-56 md:w-80 shrink-0 mx-auto md:mx-0 -mt-10 md:mt-0">
            {media.posterUrl ? (
              <div class="rounded-2xl overflow-hidden shadow-2xl ring-1 ring-white/10 transform transition-transform duration-500 hover:scale-[1.02] hover:shadow-3xl">
                <img src={media.posterUrl} alt={media.title} class="w-full h-auto" />
              </div>
            ) : (
              <div class={`aspect-[2/3] w-full flex flex-col items-center justify-center p-6 text-center rounded-2xl bg-gradient-to-br ${placeholderGrad} ring-1 ring-white/5 shadow-2xl relative overflow-hidden`}>
                <div class="absolute -top-8 -right-8 w-28 h-28 rounded-full bg-white/[0.03]"></div>
                <div class="absolute -bottom-6 -left-6 w-20 h-20 rounded-full bg-white/[0.02]"></div>
                <span class="text-white/15 mb-4 inline-block">
                  {media.type === 'film' && <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="2.5"/><line x1="8" y1="2" x2="8" y2="22"/><line x1="16" y1="2" x2="16" y2="22"/><line x1="2" y1="8" x2="22" y2="8"/><line x1="2" y1="16" x2="22" y2="16"/></svg>}
                  {media.type === 'serie' && <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="20" height="15" rx="2"/><path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/></svg>}
                  {media.type === 'anime' && <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 14.4c0 .9-.8 1.6-1.6 1.6H12l-4 5V0h12.4c.9 0 1.6.7 1.6 1.6V14.4z"/><line x1="8" y1="8" x2="16" y2="8"/><line x1="8" y1="12" x2="14" y2="12"/></svg>}
                  {media.type === 'jeu' && <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"><line x1="6" y1="11" x2="10" y2="11"/><line x1="8" y1="9" x2="8" y2="13"/><line x1="15" y1="12" x2="15.01" y2="12"/><line x1="18" y1="10" x2="18.01" y2="10"/><path d="M17.32 5H6.68a4 4 0 0 0-3.978 3.59l-1.02 8A2 2 0 0 0 3.66 19h16.68a2 2 0 0 0 1.978-2.41l-1.02-8A4 4 0 0 0 17.32 5z"/></svg>}
                  {media.type === 'webtoon' && <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H19a1 1 0 0 1 1 1v18a1 1 0 0 1-1 1H6.5A2.5 2.5 0 0 1 4 19.5z"/><line x1="8" y1="7" x2="16" y2="7"/><line x1="8" y1="11" x2="14" y2="11"/><line x1="8" y1="15" x2="16" y2="15"/></svg>}
                  {media.type === 'book' && <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20"/><line x1="8" y1="7" x2="16" y2="7"/><line x1="8" y1="11" x2="14" y2="11"/></svg>}
                  {media.type === 'novel' && <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/><line x1="8" y1="7" x2="14" y2="13"/></svg>}
                </span>
                <span class="text-white/20 text-[10px] font-bold uppercase tracking-[0.15em] mb-2.5">{typeLabels[media.type] || media.type}</span>
                <span class="text-white/45 text-xl font-display font-bold leading-snug line-clamp-8 drop-shadow-sm">{media.title}</span>
              </div>
            )}

            {/* Action buttons below poster */}
            <div class="flex gap-3 mt-5" id="detail-actions">
              <button data-action="favorite" data-id={media.id}
                class="flex-1 bg-white/10 hover:bg-red-500/30 text-white py-3 rounded-xl font-bold transition-all flex items-center justify-center gap-2 border border-white/10 hover:border-red-500/40 text-sm">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/></svg>
                Favoris
              </button>
              <button data-action="watchlist" data-id={media.id}
                class="flex-1 bg-white/10 hover:bg-blue-500/30 text-white py-3 rounded-xl font-bold transition-all flex items-center justify-center gap-2 border border-white/10 hover:border-blue-500/40 text-sm">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                A voir
              </button>
            </div>
          </div>

          {/* Info */}
          <div class="flex-1 text-white pt-2 md:pt-8">
            <div class="flex flex-wrap items-center gap-3 mb-4">
              <span class="text-[11px] font-bold uppercase tracking-widest px-3 py-1 rounded-full bg-white/10 text-white/70 border border-white/10">
                {media.type}
              </span>
              {media.year && (
                <span class="text-sm text-muted-foreground">{media.year}</span>
              )}
              {media.rating && (
                <span class="flex items-center gap-1.5 text-sm font-bold text-amber-400 bg-amber-400/10 border border-amber-400/20 px-3 py-1 rounded-full">
                  <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                  {media.rating}/10
                </span>
              )}
            </div>

            <h1 class="text-4xl md:text-6xl font-display font-bold leading-tight mb-6">
              {media.title}
            </h1>

            {media.genres && media.genres.length > 0 && (
              <div class="flex flex-wrap gap-2 mb-8">
                {media.genres.map(g => (
                  <a href={`/genres/${g.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g, '').replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '')}`}
                     class="text-xs px-3 py-1.5 rounded-lg bg-white/5 text-white/60 hover:text-primary hover:bg-primary/10 border border-white/10 hover:border-primary/30 transition-all">
                    {g}
                  </a>
                ))}
              </div>
            )}

            <div class="mb-8 max-w-3xl">
              <h3 class="text-lg font-bold mb-2 text-white/80">Synopsis</h3>
              <p class="text-base md:text-lg text-muted-foreground leading-relaxed">
                {media.synopsis || "Aucun synopsis disponible."}
              </p>
            </div>

            {/* Episodes section */}
            {isEpisodeBased && hasEpisodes && (
              <div class="mb-8">
                <h3 class="text-lg font-bold mb-4 text-white/80">Episodes</h3>
                <div class="space-y-2 max-h-96 overflow-y-auto pr-2">
                  {media.episodes!.map(ep => (
                    <div class="flex items-center gap-4 bg-white/5 rounded-xl px-4 py-3 border border-white/5 hover:bg-white/[0.07] transition-colors">
                      <span class="text-white/30 text-sm font-mono w-20 shrink-0">
                        S{String(ep.season_number).padStart(2, '0')}E{String(ep.episode_number).padStart(2, '0')}
                      </span>
                      <span class="text-sm text-white/80 leading-snug line-clamp-1">
                        {ep.title || `Episode ${ep.episode_number}`}
                      </span>
                    </div>
                  ))}
                </div>
              </div>
            )}

            {/* Links section */}
            {hasLinks && (
              <div>
                <h3 class="text-lg font-bold mb-4 text-white/80">Liens de streaming</h3>
                <div class="flex flex-wrap gap-2">
                  {[...new Set(media.links!.map(l => l.source_site))].map(site => (
                    <a href={media.links!.find(l => l.source_site === site)!.url}
                       target="_blank"
                       class="text-xs px-4 py-2 rounded-lg bg-primary/10 text-primary border border-primary/20 hover:bg-primary/20 hover:border-primary/40 transition-all">
                      {site}
                    </a>
                  ))}
                </div>
              </div>
            )}
          </div>
        </div>
      </div>
    </div>
  ) : null}

  <div id="detail-page-data" data-media={scriptData ? JSON.stringify(scriptData) : ''} style="display:none"></div>

  <script>
    const el = document.getElementById('detail-page-data');
    const raw = el?.dataset.media;
    const d = raw ? JSON.parse(raw) : null;
    const mediaId = d && d.id;
    const mediaType = d && d.type;
    const mediaTitle = d && d.title;
    const mediaSlug = d && d.slug;
    const mediaPoster = d && d.posterUrl;
    const mediaYear = d && d.year;
    const mediaRating = d && d.rating;

    function openDB() {
      return new Promise((resolve, reject) => {
        const r = indexedDB.open('webmedia', 1);
        r.onupgradeneeded = (e) => {
          const db = e.target.result;
          if (!db.objectStoreNames.contains('favorites')) db.createObjectStore('favorites', { keyPath: 'id' });
          if (!db.objectStoreNames.contains('watchlist')) db.createObjectStore('watchlist', { keyPath: 'id' });
        };
        r.onsuccess = (e) => resolve(e.target.result);
        r.onerror = () => reject(r.error);
      });
    }

    function dbPut(storeName, data) {
      return openDB().then((db) => {
        const tx = db.transaction(storeName, 'readwrite');
        tx.objectStore(storeName).put(data);
        return new Promise((resolve) => { tx.oncomplete = () => { db.close(); resolve(null); }; });
      });
    }

    function dbDelete(storeName, id) {
      return openDB().then((db) => {
        const tx = db.transaction(storeName, 'readwrite');
        tx.objectStore(storeName).delete(id);
        return new Promise((resolve) => { tx.oncomplete = () => { db.close(); resolve(null); }; });
      });
    }

    function dbHas(storeName, id) {
      return openDB().then((db) => {
        const tx = db.transaction(storeName, 'readonly');
        const req = tx.objectStore(storeName).get(id);
        return new Promise((resolve) => { req.onsuccess = () => { tx.oncomplete = () => db.close(); resolve(!!req.result); }; });
      });
    }

    const favBtn = document.querySelector('[data-action="favorite"]');
    const wlBtn = document.querySelector('[data-action="watchlist"]');

    async function toggleList(store, id, meta) {
      const has = await dbHas(store, id);
      if (has) { await dbDelete(store, id); }
      else { await dbPut(store, { id, ...meta, addedAt: Date.now() }); }
      updateButtons();
    }

    async function updateButtons() {
      if (favBtn) {
        const inFav = await dbHas('favorites', mediaId);
        favBtn.innerHTML = inFav
          ? '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" stroke="none"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/></svg> Favori'
          : '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/></svg> Favoris';
        favBtn.className = inFav
          ? 'flex-1 bg-red-500/20 text-red-400 py-3 rounded-xl font-bold transition-all flex items-center justify-center gap-2 border border-red-500/30 text-sm'
          : 'flex-1 bg-white/10 hover:bg-red-500/30 text-white py-3 rounded-xl font-bold transition-all flex items-center justify-center gap-2 border border-white/10 hover:border-red-500/40 text-sm';
      }
      if (wlBtn) {
        const inWl = await dbHas('watchlist', mediaId);
        wlBtn.innerHTML = inWl
          ? '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" stroke="none"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg> Dans la liste'
          : '<svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg> A voir';
        wlBtn.className = inWl
          ? 'flex-1 bg-blue-500/20 text-blue-400 py-3 rounded-xl font-bold transition-all flex items-center justify-center gap-2 border border-blue-500/30 text-sm'
          : 'flex-1 bg-white/10 hover:bg-blue-500/30 text-white py-3 rounded-xl font-bold transition-all flex items-center justify-center gap-2 border border-white/10 hover:border-blue-500/40 text-sm';
      }
    }

    document.addEventListener('DOMContentLoaded', updateButtons);
    favBtn?.addEventListener('click', () => toggleList('favorites', mediaId, { type: mediaType, title: mediaTitle, slug: mediaSlug, posterUrl: mediaPoster, rating: Number(mediaRating), year: Number(mediaYear) }));
    wlBtn?.addEventListener('click', () => toggleList('watchlist', mediaId, { type: mediaType, title: mediaTitle, slug: mediaSlug, posterUrl: mediaPoster, rating: Number(mediaRating), year: Number(mediaYear) }));
  </script>
</Layout>
