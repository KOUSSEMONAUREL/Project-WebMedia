---
import Layout from '../layouts/Layout.astro';
import { getMediaByType, type Media } from '../lib/api';

let webtoons: Media[] = [];
try {
  const res = await getMediaByType('webtoon');
  webtoons = res.data || [];
} catch {}
---

<Layout title="Webtoons">
  <div class="relative overflow-hidden">
    <!-- Hero section -->
    <div class="relative pt-20 pb-16 md:pt-28 md:pb-20 bg-gradient-to-b from-orange-950/60 via-background to-background">
      <div class="absolute inset-0 overflow-hidden pointer-events-none">
        <div class="absolute top-10 left-10 w-72 h-72 bg-orange-500/10 rounded-full blur-3xl" />
        <div class="absolute -bottom-10 right-20 w-64 h-64 bg-yellow-500/5 rounded-full blur-3xl" />
      </div>
      <div class="container mx-auto px-6 relative">
        <div class="flex flex-col md:flex-row items-center gap-8 md:gap-16">
          <div class="flex-shrink-0">
            <div class="w-28 h-28 md:w-36 md:h-36 rounded-2xl bg-gradient-to-br from-orange-500 to-amber-600 flex items-center justify-center shadow-2xl shadow-orange-500/30">
              <svg class="w-14 h-14 md:w-20 md:h-20 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/>
                <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>
              </svg>
            </div>
          </div>
          <div class="text-center md:text-left">
            <h1 class="text-5xl md:text-7xl lg:text-8xl font-display font-bold text-white leading-tight">
              <span class="text-orange-400 italic">WEBTOONS</span>
            </h1>
            <p class="mt-3 text-lg md:text-xl text-muted-foreground max-w-xl font-light">
              BD numérique coréenne. Des histoires à dévorer en chapitres, avec un style visuel unique.
            </p>
            <div class="mt-6 flex flex-wrap gap-3 justify-center md:justify-start">
              <span class="px-4 py-1.5 bg-orange-500/20 text-orange-300 rounded-full text-sm border border-orange-500/30">Manhwa</span>
              <span class="px-4 py-1.5 bg-orange-500/20 text-orange-300 rounded-full text-sm border border-orange-500/30">Fantastique</span>
              <span class="px-4 py-1.5 bg-orange-500/20 text-orange-300 rounded-full text-sm border border-orange-500/30">Action</span>
              <span class="px-4 py-1.5 bg-orange-500/20 text-orange-300 rounded-full text-sm border border-orange-500/30">Romance</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Grid section avec style webtoon -->
    <div class="container mx-auto px-6 pb-16">
      <div class="border-l-4 border-orange-500 pl-4 mb-10">
        <p class="text-sm text-orange-400 font-medium uppercase tracking-widest">Catalogue</p>
        <h2 class="text-2xl font-display font-semibold text-white">Tous les webtoons</h2>
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 gap-6 md:gap-8">
        {webtoons.length > 0 ? webtoons.map((m) => (
          <a href={`/${m.type}/${m.slug}`} class="group flex flex-col gap-3 transition-all duration-500 hover:-translate-y-2">
            <div class="relative aspect-[2/3] w-full overflow-hidden rounded-xl shadow-lg border border-white/5 group-hover:shadow-orange-500/20 group-hover:shadow-2xl transition-all duration-500">
              <img src={m.posterUrl} alt={m.title} class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105" loading="lazy" onerror="this.src='https://via.placeholder.com/300x450?text=?'" />
              <div class="absolute top-2 right-2 bg-black/60 backdrop-blur px-2 py-0.5 rounded text-yellow-500 text-xs font-bold flex items-center gap-1">
                <svg class="w-3 h-3 fill-current" viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                {m.rating}
              </div>
            </div>
            <h3 class="font-display font-semibold text-base text-foreground group-hover:text-orange-400 transition-colors line-clamp-2">{m.title}</h3>
            <p class="text-xs text-muted-foreground">{m.year}</p>
          </a>
        )) : (
          <div class="col-span-full py-20 text-center text-muted-foreground">Aucun webtoon trouvé.</div>
        )}
      </div>
    </div>
  </div>
</Layout>
