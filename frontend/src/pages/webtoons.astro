---
import Layout from '../layouts/Layout.astro';
import { MediaGrid } from '../components/MediaGrid';
import { DynamicHero } from '../components/DynamicHero';
import { getMediaByType, type Media } from '../lib/api';

let webtoons: Media[] = [];
try {
  const res = await getMediaByType('webtoon');
  webtoons = res.data || [];
} catch {}
---

<Layout title="Webtoons">
  <div class="container mx-auto px-6 py-10">
    <DynamicHero 
        client:load 
        defaultTitle="Webtoons" 
        defaultSubtitle="BD numérique coréenne. Des histoires à dévorer en chapitres, avec un style visuel unique."
    />
    <MediaGrid title="Webtoons" items={webtoons} client:load />
  </div>
</Layout>
