---
import Layout from '../layouts/Layout.astro';
import { MediaGrid } from '../components/MediaGrid';
import { PageHeader } from '../components/PageHeader';
import { getMediaByType, type Media } from '../lib/api';

let webtoons: Media[] = [];
try {
  const res = await getMediaByType('webtoon');
  webtoons = res.data || [];
} catch {}
---

<Layout title="Webtoons">
  <div class="container mx-auto px-6 py-10">
    <PageHeader title="Webtoons" subtitle="BD numérique coréenne. Des histoires à dévorer en chapitres, avec un style visuel unique." />
    <MediaGrid title="Webtoons" items={webtoons} client:load />
  </div>
</Layout>
