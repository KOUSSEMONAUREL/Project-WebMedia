---
import Layout from '../layouts/Layout.astro';
import { CategoryGrid } from '../components/CategoryGrid';
import { getMediaByType } from '../lib/api';

let initialData: any[] = [];
let initialTotal = 0;
try {
  const result = await getMediaByType('comic', { limit: 20, sort: 'created_at', order: 'desc' });
  initialData = result.data || [];
  initialTotal = result.total || 0;
} catch (e) {
  console.error('[comics] SSR error:', e);
}
---

<Layout title="Comics" description="Tous les comics disponibles sur WebMediia. Classement et filtres." canonicalUrl="https://www.webmediia.cfd/comics">
  <CategoryGrid type="comic" title="Comics" client:visible initialData={initialData} initialTotal={initialTotal} />
</Layout>
