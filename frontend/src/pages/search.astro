---
import Layout from '../layouts/Layout.astro';
import GridPage from '../components/GridPage.astro';
import { searchMedia, type Media, type MediaType } from '../lib/api';

const query = Astro.url.searchParams.get('q') || '';
const type = Astro.url.searchParams.get('type') || undefined;

let results: Media[] = [];
let error = '';

if (query) {
  try {
    const res = await searchMedia(query, type ? { type: type as MediaType } : {});
    results = res.data || [];
  } catch (e) {
    error = "Erreur lors de la recherche.";
  }
}
---

{query && !error ? (
  <GridPage
    title={`Recherche${type ? ` ${type}s` : ''}: ${query}`}
    items={results}
    pageTitle={`Recherche${type ? ` ${type}s` : ''}: ${query}`}
    description={`${results.length} résultat${results.length > 1 ? 's' : ''} pour "${query}"${type ? ` dans ${type}s` : ''}`}
  />
) : (
  <Layout title="Recherche">
    <div class="container mx-auto px-6 pt-28 pb-16">
      <header class="mb-12">
        <h1 class="text-4xl font-black italic uppercase tracking-tighter text-white border-l-4 border-primary pl-4">
          RECHERCHE
        </h1>
        {query && <p class="mt-2 text-red-400">{error || 'Aucun resultat trouve.'}</p>}
      </header>
      {!query && (
        <div class="flex flex-col items-center justify-center min-h-[40vh] text-center">
          <p class="text-muted-foreground text-lg">Utilisez la barre de recherche pour trouver du contenu.</p>
        </div>
      )}
    </div>
  </Layout>
)}
