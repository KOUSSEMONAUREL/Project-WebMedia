---
import Layout from '../layouts/Layout.astro';
const error = Astro.url.searchParams.get('error');
const errorMessages: Record<string, string> = {
  TOKEN_EXPIRED: 'Le lien a expire. Demande un nouvel email de verification.',
  INVALID_TOKEN: 'Lien invalide. Demande un nouvel email de verification.',
  USER_NOT_FOUND: 'Utilisateur introuvable.',
  EMAIL_ALREADY_VERIFIED: 'Email deja verifie. Connecte-toi !',
};
const errorMsg = error ? (errorMessages[error] || 'Erreur inconnue.') : null;
---
<Layout title="Email verifie">
  <div class="min-h-[60vh] flex items-center justify-center px-4">
    <div class="text-center max-w-md">
      {errorMsg ? (
        <>
          <div class="inline-flex items-center justify-center w-20 h-20 rounded-full bg-red-500/10 mb-6">
            <svg class="h-10 w-10 text-red-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
          </div>
          <h1 class="text-2xl font-bold mb-3">Verification echouee</h1>
          <p class="text-muted-foreground mb-6">{errorMsg}</p>
        </>
      ) : (
        <>
          <div class="inline-flex items-center justify-center w-20 h-20 rounded-full bg-green-500/10 mb-6">
            <svg class="h-10 w-10 text-green-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
          </div>
          <h1 class="text-2xl font-bold mb-3">Email verifie !</h1>
          <p class="text-muted-foreground mb-6">Ton adresse email est confirmee. Tu peux maintenant te connecter.</p>
        </>
      )}
      <a
        href="/"
        class="inline-flex items-center gap-2 px-6 py-3 rounded-xl font-semibold text-sm transition-all"
        style="background:linear-gradient(135deg,#60a5fa,#3b82f6);color:#fff"
      >
        <svg class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M10 19l-7-7m0 0l7-7m-7 7h18"/>
        </svg>
        Retour a l'accueil
      </a>
    </div>
  </div>
</Layout>
