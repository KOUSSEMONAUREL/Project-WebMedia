---
import Layout from '../layouts/Layout.astro';
import { MediaGrid } from '../components/MediaGrid';
import { getMediaByType, type Media } from '../lib/api';

let films: Media[] = [];
try {
  const res = await getMediaByType('film');
  films = res.data || [];
} catch {}
---

<Layout title="Films">
  <div class="relative overflow-hidden">
    <!-- Hero section -->
    <div class="relative pt-20 pb-16 md:pt-28 md:pb-20 bg-gradient-to-b from-blue-950/60 via-background to-background">
      <div class="absolute inset-0 overflow-hidden pointer-events-none">
        <div class="absolute -top-40 -right-40 w-96 h-96 bg-blue-500/10 rounded-full blur-3xl" />
        <div class="absolute -bottom-20 -left-20 w-72 h-72 bg-primary/5 rounded-full blur-3xl" />
      </div>
      <div class="container mx-auto px-6 relative">
        <div class="flex flex-col md:flex-row items-center gap-8 md:gap-16">
          <div class="flex-shrink-0">
            <div class="w-28 h-28 md:w-36 md:h-36 rounded-2xl bg-gradient-to-br from-blue-500 to-blue-700 flex items-center justify-center shadow-2xl shadow-blue-500/30">
              <svg class="w-14 h-14 md:w-20 md:h-20 text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                <rect x="2" y="2" width="20" height="20" rx="2.18" ry="2.18"/>
                <line x1="7" y1="2" x2="7" y2="22"/>
                <line x1="17" y1="2" x2="17" y2="22"/>
                <line x1="2" y1="12" x2="22" y2="12"/>
                <line x1="2" y1="7" x2="7" y2="7"/>
                <line x1="2" y1="17" x2="7" y2="17"/>
                <line x1="17" y1="7" x2="22" y2="7"/>
                <line x1="17" y1="17" x2="22" y2="17"/>
              </svg>
            </div>
          </div>
          <div class="text-center md:text-left">
            <h1 class="text-5xl md:text-7xl lg:text-8xl font-display font-bold text-white leading-tight">
              <span class="text-blue-400 italic">CINÉMA</span>
            </h1>
            <p class="mt-3 text-lg md:text-xl text-muted-foreground max-w-xl font-light">
              L'art du septième art. Des classiques intemporels aux chefs-d'œuvre modernes.
            </p>
            <div class="mt-6 flex flex-wrap gap-3 justify-center md:justify-start">
              <span class="px-4 py-1.5 bg-blue-500/20 text-blue-300 rounded-full text-sm border border-blue-500/30">Action</span>
              <span class="px-4 py-1.5 bg-blue-500/20 text-blue-300 rounded-full text-sm border border-blue-500/30">Drame</span>
              <span class="px-4 py-1.5 bg-blue-500/20 text-blue-300 rounded-full text-sm border border-blue-500/30">Science-Fiction</span>
              <span class="px-4 py-1.5 bg-blue-500/20 text-blue-300 rounded-full text-sm border border-blue-500/30">Comédie</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Grid section avec style film -->
    <div class="container mx-auto px-6 pb-16">
      <div class="border-l-4 border-blue-500 pl-4 mb-10">
        <p class="text-sm text-blue-400 font-medium uppercase tracking-widest">Catalogue</p>
        <h2 class="text-2xl font-display font-semibold text-white">Tous les films</h2>
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6 gap-6 md:gap-8">
        {films.length > 0 ? films.map((m) => (
          <a href={`/${m.type}/${m.slug}`} class="group flex flex-col gap-3 transition-all duration-500 hover:-translate-y-2">
            <div class="relative aspect-[2/3] w-full overflow-hidden rounded-xl shadow-lg border border-white/5 group-hover:shadow-blue-500/20 group-hover:shadow-2xl transition-all duration-500">
              <img src={m.posterUrl} alt={m.title} class="h-full w-full object-cover transition-transform duration-700 group-hover:scale-105" loading="lazy" onerror="this.src='https://via.placeholder.com/300x450?text=?'" />
              <div class="absolute top-2 right-2 bg-black/60 backdrop-blur px-2 py-0.5 rounded text-yellow-500 text-xs font-bold flex items-center gap-1">
                <svg class="w-3 h-3 fill-current" viewBox="0 0 24 24"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
                {m.rating}
              </div>
            </div>
            <h3 class="font-display font-semibold text-base text-foreground group-hover:text-blue-400 transition-colors line-clamp-2">{m.title}</h3>
            <p class="text-xs text-muted-foreground">{m.year}</p>
          </a>
        )) : (
          <div class="col-span-full py-20 text-center text-muted-foreground">Aucun film trouvé.</div>
        )}
      </div>
    </div>
  </div>
</Layout>
