---
import Layout from '../layouts/Layout.astro';
import { MediaGrid } from '../components/MediaGrid';
import { DynamicHero } from '../components/DynamicHero';
import { getMediaByType, type Media } from '../lib/api';

let films: Media[] = [];
try {
  const res = await getMediaByType('film');
  films = res.data || [];
} catch {}
---

<Layout title="Films">
  <div class="container mx-auto px-6 py-10">
    <DynamicHero 
        client:load 
        defaultTitle="Films" 
        defaultSubtitle="L'art du septième art. Des classiques intemporels aux chefs-d'œuvre modernes."
    />
    <MediaGrid title="Films" items={films} client:load />
  </div>
</Layout>
