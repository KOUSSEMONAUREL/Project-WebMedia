---
import Layout from '../layouts/Layout.astro';
import type { Media } from '@/lib/api';
import { optimizePosterUrl, posterSrcSet } from '@/lib/image';

export interface Props {
  title: string;
  items: Media[];
  pageTitle: string;
  description?: string;
}

const { title, items, pageTitle, description } = Astro.props;
const PER_PAGE = 16;
const totalPages = Math.max(1, Math.ceil(items.length / PER_PAGE));
const firstPage = items.slice(0, PER_PAGE);
const ITEMS_JSON = JSON.stringify(items);

function posterImg(m: Media): string {
  if (!m.posterUrl) return '';
  const opt = optimizePosterUrl(m.posterUrl)!;
  const ss = posterSrcSet(m.posterUrl);
  return `<img src="${opt}"${ss ? ` srcset="${ss}"` : ''} sizes="(max-width:640px) 160px, (max-width:1024px) 200px, 260px" alt="${m.title}" class="absolute inset-0 z-10 h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.08]" loading="lazy" onerror="this.style.display='none'"/>`;
}

function cardHtml(m: Media): string {
  const h = `/${m.type}/${m.slug || m.id}`;
  return `<a href="${h}" class="group block transition-all duration-300 hover:-translate-y-1.5">
    <div class="aspect-[2/3] w-full overflow-hidden rounded-xl bg-secondary shadow-md transition-all duration-300 group-hover:shadow-xl group-hover:ring-1 group-hover:ring-primary/20 relative" style="border:1px solid rgba(255,255,255,0.06)">
      ${posterImg(m)}
      <div class="absolute inset-0 flex flex-col items-center justify-center p-5 text-center bg-gradient-to-br from-secondary to-card">
        <span class="text-white/30 text-xs font-bold uppercase tracking-[0.15em] mb-2">${m.type.toUpperCase()}</span>
        <span class="text-white/50 text-base font-bold leading-snug line-clamp-6 drop-shadow-sm" style="font-family:'Clash Display',sans-serif">${m.title}</span>
      </div>
      <div class="absolute top-2.5 right-2.5 flex items-center gap-1 bg-black/60 backdrop-blur-sm px-2 py-1 rounded-lg z-20">
        <svg width="11" height="11" viewBox="0 0 24 24" fill="#f59e0b"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
        <span class="text-xs font-bold text-amber-400">${m.rating || ''}</span>
      </div>
    </div>
    <div class="mt-2.5 px-0.5">
      <h3 class="font-display font-bold text-[15px] leading-snug text-foreground group-hover:text-primary transition-colors line-clamp-2">${m.title}</h3>
      <div class="flex items-center gap-3 mt-1.5 text-[13px] text-muted-foreground">
        ${m.year ? `<span>${m.year}</span>` : ''}
        ${m.rating ? `<span class="flex items-center gap-1 ml-auto"><svg width="11" height="11" viewBox="0 0 24 24" fill="#f59e0b"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>${m.rating}</span>` : ''}
      </div>
    </div>
  </a>`;
}
---

<Layout title={pageTitle}>
  <div class="container mx-auto px-6 py-10">
    <header class="mb-8">
      <h1
        class="text-2xl md:text-3xl font-display font-bold mb-2"
        style="background:linear-gradient(135deg,#93c5fd,#60a5fa);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text"
      >
        {title}
      </h1>
      {description && <p class="text-muted-foreground text-sm">{description}</p>}
    </header>

    <div id="category-grid" data-items={ITEMS_JSON} data-per-page={PER_PAGE}>
      {totalPages > 1 && (
        <div class="flex items-center justify-center gap-2 mb-8 flex-wrap">
          <button data-page-btn="prev" class="page-btn px-4 py-2 rounded-lg bg-secondary/50 text-muted-foreground text-sm font-medium disabled:opacity-30 disabled:cursor-not-allowed" disabled>
            Precedent
          </button>
          {Array.from({ length: totalPages }, (_, i) => (
            <button
              class={`page-btn w-9 h-9 rounded-lg text-sm font-bold transition-colors ${i === 0 ? 'bg-primary text-primary-foreground' : 'bg-secondary/50 text-muted-foreground hover:text-primary hover:bg-secondary'}`}
              data-page={i + 1}
            >
              {i + 1}
            </button>
          ))}
          <button data-page-btn="next" class="page-btn px-4 py-2 rounded-lg bg-secondary/50 text-muted-foreground text-sm font-medium disabled:opacity-30 disabled:cursor-not-allowed">
            Suivant
          </button>
        </div>
      )}

      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-x-5 gap-y-8">
        {firstPage.map((m) => <Fragment set:html={cardHtml(m)} />)}
      </div>

      {totalPages > 1 && (
        <div class="flex items-center justify-center gap-2 mt-12 flex-wrap">
          <button data-page-btn="prev" class="page-btn px-4 py-2 rounded-lg bg-secondary/50 text-muted-foreground text-sm font-medium disabled:opacity-30 disabled:cursor-not-allowed" disabled>
            Precedent
          </button>
          {Array.from({ length: totalPages }, (_, i) => (
            <button
              class={`page-btn w-9 h-9 rounded-lg text-sm font-bold transition-colors ${i === 0 ? 'bg-primary text-primary-foreground' : 'bg-secondary/50 text-muted-foreground hover:text-primary hover:bg-secondary'}`}
              data-page={i + 1}
            >
              {i + 1}
            </button>
          ))}
          <button data-page-btn="next" class="page-btn px-4 py-2 rounded-lg bg-secondary/50 text-muted-foreground text-sm font-medium disabled:opacity-30 disabled:cursor-not-allowed">
            Suivant
          </button>
        </div>
      )}
    </div>
  </div>
</Layout>

<script data-astro-rerun>
(function(){
  var cat = document.getElementById('category-grid');
  if (!cat) return;

  var items = JSON.parse(cat.dataset.items);
  var PER_PAGE = Number(cat.dataset.perPage);
  var totalPages = Math.ceil(items.length / PER_PAGE);

  function card(m) {
    var img = '';
    if (m.posterUrl) {
      var u = m.posterUrl;
      if (/image\.tmdb\.org/.test(u)) u = u.replace(/\/t\/p\/\w+\//, '/t/p/original/');
      else if (/books\.google\.com/.test(u)) u = u.replace(/zoom=\d+/, 'zoom=6');
      else if (/anilist\.co/.test(u)) u = u.replace(/\/large\//, '/extraLarge/');
      var ss = '';
      if (/image\.tmdb\.org/.test(m.posterUrl)) {
        var sizes = [342,500,780,1200];
        var names = ['w342','w500','w780','original'];
        ss = ' srcset="';
        for (var si=0; si<4; si++) ss += m.posterUrl.replace(/\/t\/p\/\w+\//, '/t/p/'+names[si]+'/') + ' ' + sizes[si] + 'w' + (si<3?',':'');
        ss += '"';
      }
      img = '<img src="' + u + '"' + ss + ' sizes="(max-width:640px) 160px, (max-width:1024px) 200px, 320px" alt="" class="absolute inset-0 z-10 h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.08]" loading="lazy" onerror="this.style.display=\'none\'"/>';
    }
    var h = m.slug || m.id;
    return '<a href="/' + m.type + '/' + h + '" class="group block transition-all duration-300 hover:-translate-y-1.5">'
      + '<div class="aspect-[2/3] w-full overflow-hidden rounded-xl bg-secondary shadow-md transition-all duration-300 group-hover:shadow-xl group-hover:ring-1 group-hover:ring-primary/20 relative" style="border:1px solid rgba(255,255,255,0.06)">'
      + img
      + '<div class="absolute inset-0 flex flex-col items-center justify-center p-5 text-center bg-gradient-to-br from-secondary to-card">'
      + '<span class="text-white/30 text-xs font-bold uppercase tracking-[0.15em] mb-2">' + m.type.toUpperCase() + '</span>'
      + '<span class="text-white/50 text-base font-bold leading-snug line-clamp-6 drop-shadow-sm" style="font-family:\'Clash Display\',sans-serif">' + m.title + '</span></div>'
      + '<div class="absolute top-2.5 right-2.5 flex items-center gap-1 bg-black/60 backdrop-blur-sm px-2 py-1 rounded-lg z-20">'
      + '<svg width="11" height="11" viewBox="0 0 24 24" fill="#f59e0b"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>'
      + '<span class="text-xs font-bold text-amber-400">' + (m.rating || '') + '</span></div></div>'
      + '<div class="mt-2.5 px-0.5">'
      + '<h3 class="font-display font-bold text-[15px] leading-snug text-foreground group-hover:text-primary transition-colors line-clamp-2">' + m.title + '</h3>'
      + '<div class="flex items-center gap-3 mt-1.5 text-[13px] text-muted-foreground">'
      + (m.year ? '<span>' + m.year + '</span>' : '')
      + (m.rating ? '<span class="flex items-center gap-1 ml-auto"><svg width="11" height="11" viewBox="0 0 24 24" fill="#f59e0b"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>' + m.rating + '</span>' : '')
      + '</div></div></a>';
  }

  function gotoPage(page) {
    cat.dataset.currentPage = String(page);
    var s = page * PER_PAGE;
    var e = s + PER_PAGE;
    var g = cat.querySelector('.grid');
    if (g) g.innerHTML = items.slice(s, e).map(card).join('');
    cat.querySelectorAll('[data-page-btn="prev"]').forEach(function(b) { b.disabled = page <= 0; });
    cat.querySelectorAll('[data-page-btn="next"]').forEach(function(b) { b.disabled = page >= totalPages - 1; });
    cat.querySelectorAll('[data-page]').forEach(function(b) {
      var n = Number(b.dataset.page) - 1;
      b.className = 'page-btn w-9 h-9 rounded-lg text-sm font-bold transition-colors '
        + (n === page ? 'bg-primary text-primary-foreground' : 'bg-secondary/50 text-muted-foreground hover:text-primary hover:bg-secondary');
    });
    window.scrollTo({ top: Math.max(0, cat.offsetTop - 80), behavior: 'smooth' });
  }

  cat.addEventListener('click', function(e) {
    var cur = Number(cat.dataset.currentPage || 0);
    var b = e.target.closest('[data-page]');
    var p = e.target.closest('[data-page-btn="prev"]');
    var n = e.target.closest('[data-page-btn="next"]');
    if (!p && !n && !b) return;
    if (p && !p.disabled && cur > 0) { gotoPage(cur - 1); return; }
    if (n && !n.disabled && cur < totalPages - 1) { gotoPage(cur + 1); return; }
    if (b) { gotoPage(Number(b.dataset.page) - 1); }
  });
})();
</script>
