---
interface Props { links?: any[]; legalLinks?: any[]; type: string; tmdbId?: number }

const { links = [], legalLinks = [], type, tmdbId } = Astro.props;
const active = links.filter((l: any) => {
  const isActive = (l.is_active ?? l.isActive ?? 1) !== 0;
  return isActive && !l.episode_id && !l.episodeId;
});
const isStreaming = type === 'film' || type === 'serie' || type === 'anime';
const showDynamic = type === 'film' && !!tmdbId;
const showDbLinks = !isStreaming;
const show = active.length > 0 || legalLinks.length > 0 || showDynamic;

const label = type === 'jeu' ? 'Téléchargement' : (type === 'book' || type === 'novel') ? 'Lecture' : 'Streaming';
const groups = new Map<string, any[]>();
for (const l of active) { const s = l.source_site || l.sourceSite || 'Source'; if (!groups.has(s)) groups.set(s, []); groups.get(s)!.push(l); }

const STREAMING_SOURCES = [
  { name: 'vsembed.ru', host: 'vsembed.ru', movieUrl: (id: number) => `https://vsembed.ru/embed/movie?tmdb=${id}`, tvUrl: (id: number, s: number, e: number) => `https://vsembed.ru/embed/tv?tmdb=${id}&season=${s}&episode=${e}` },
  { name: 'vsembed.su', host: 'vsembed.su', movieUrl: (id: number) => `https://vsembed.su/embed/movie?tmdb=${id}`, tvUrl: (id: number, s: number, e: number) => `https://vsembed.su/embed/tv?tmdb=${id}&season=${s}&episode=${e}` },
  { name: 'vidsrcme.ru', host: 'vidsrcme.ru', movieUrl: (id: number) => `https://vidsrcme.ru/embed/movie?tmdb=${id}`, tvUrl: (id: number, s: number, e: number) => `https://vidsrcme.ru/embed/tv?tmdb=${id}&sea=${s}&epi=${e}` },
  { name: 'vidsrc.to', host: 'vidsrc.to', movieUrl: (id: number) => `https://vidsrc.to/embed/movie/${id}`, tvUrl: (id: number, s: number, e: number) => `https://vidsrc.to/embed/tv/${id}/${s}/${e}` },
  { name: '2embed.cc', host: 'www.2embed.cc', movieUrl: (id: number) => `https://www.2embed.cc/embed/movie/${id}`, tvUrl: (id: number, s: number, e: number) => `https://www.2embed.cc/embed/tv/${id}/${s}/${e}` },
];
---

{show && (
<div class="max-w-5xl mx-auto space-y-8">

  {legalLinks.length > 0 && (
    <div>
      <h3 class="text-xs font-semibold uppercase tracking-widest mb-3" style="color: rgba(16,185,129,0.5);">Légal</h3>
      <div class="flex flex-wrap gap-2">
        {legalLinks.map((ll: any) => (
          <a href={ll.url} target="_blank"
             class="inline-flex items-center gap-2 px-4 py-2 rounded-xl text-sm font-medium transition-all"
             style="background: rgba(16,185,129,0.06); border: 1px solid rgba(16,185,129,0.1); color: #34D399;">
            {ll.platform || ll.site || ll.label || ll.url}
          </a>
        ))}
      </div>
    </div>
  )}

  {isStreaming && tmdbId && type === 'film' && (
    <div>
      <h3 class="text-xs font-semibold uppercase tracking-widest mb-3" style="color: rgba(255,255,255,0.4);">Streaming</h3>
      <div class="flex flex-wrap gap-2">
        {STREAMING_SOURCES.map(src => (
          <a href={src.movieUrl(tmdbId)} target="_blank"
             class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl text-sm font-medium transition-all"
             style="background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.06); color: rgba(255,255,255,0.7);">
            {src.name}
          </a>
        ))}
      </div>
    </div>
  )}

  {showDbLinks && active.length > 0 && (
    <div>
      <h3 class="text-xs font-semibold uppercase tracking-widest mb-3" style="color: rgba(255,255,255,0.4);">{label}</h3>
      <div class="flex flex-wrap gap-2">
        {[...groups.entries()].map(([site, siteLinks]) => {
          const best = siteLinks[0];
          return (
            <a href={best.url} target="_blank"
               class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl text-sm font-medium transition-all"
               style="background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.06); color: rgba(255,255,255,0.7);">
              {site}
              {best.player_host || best.playerHost && (
                <span class="text-[10px]" style="color: rgba(255,255,255,0.25);">{best.player_host || best.playerHost}</span>
              )}
              {best.quality && (
                <span class="text-[10px] font-semibold px-1.5 py-0.5 rounded" style="background: rgba(255,255,255,0.06); color: rgba(255,255,255,0.4);">{best.quality}</span>
              )}
              {best.language && (
                <span class="text-[10px]" style="color: rgba(255,255,255,0.25);">{best.language}</span>
              )}
              {(best.has_subtitles ?? best.hasSubtitles) && (
                <span class="text-[10px]" style="color: rgba(251,191,36,0.5);">SOUS-TITRES</span>
              )}
            </a>
          );
        })}
      </div>
    </div>
  )}
</div>
)}
