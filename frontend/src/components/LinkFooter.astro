---
interface Props { links?: any[]; legalLinks?: any[]; type: string }

const { links = [], legalLinks = [], type } = Astro.props;
const active = links.filter((l: any) => (l.is_active ?? l.isActive ?? 1) !== 0);
const show = active.length > 0 || legalLinks.length > 0;

const label = type === 'jeu' ? 'Téléchargement' : (type === 'book' || type === 'novel') ? 'Lecture' : 'Streaming';
const groups = new Map<string, any[]>();
for (const l of active) { const s = l.source_site || l.sourceSite || 'Source'; if (!groups.has(s)) groups.set(s, []); groups.get(s)!.push(l); }
---

{show && (
<div class="max-w-5xl mx-auto space-y-8">

  {legalLinks.length > 0 && (
    <div>
      <h3 class="text-xs font-semibold uppercase tracking-widest mb-3" style="color: rgba(16,185,129,0.5);">Légal</h3>
      <div class="flex flex-wrap gap-2">
        {legalLinks.map((ll: any) => (
          <a href={ll.url} target="_blank"
             class="inline-flex items-center gap-2 px-4 py-2 rounded-xl text-sm font-medium transition-all"
             style="background: rgba(16,185,129,0.06); border: 1px solid rgba(16,185,129,0.1); color: #34D399;">
            {ll.platform || ll.site || ll.label || ll.url}
          </a>
        ))}
      </div>
    </div>
  )}

  {active.length > 0 && (
    <div>
      <h3 class="text-xs font-semibold uppercase tracking-widest mb-3" style="color: rgba(255,255,255,0.4);">{label}</h3>
      <div class="flex flex-wrap gap-2">
        {[...groups.entries()].map(([site, siteLinks]) => {
          const best = siteLinks[0];
          return (
            <a href={best.url} target="_blank"
               class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl text-sm font-medium transition-all"
               style="background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.06); color: rgba(255,255,255,0.7);">
              {site}
              {best.quality && (
                <span class="text-[10px] font-semibold px-1.5 py-0.5 rounded" style="background: rgba(255,255,255,0.06); color: rgba(255,255,255,0.4);">{best.quality}</span>
              )}
              {best.language && (
                <span class="text-[10px]" style="color: rgba(255,255,255,0.25);">{best.language}</span>
              )}
            </a>
          );
        })}
      </div>
    </div>
  )}
</div>
)}
