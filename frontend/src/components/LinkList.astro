---
interface LinkItem {
  source_site?: string;
  sourceSite?: string;
  url: string;
  quality?: string;
  language?: string;
  is_active?: number | boolean;
  isActive?: number | boolean;
  player_host?: string;
  playerHost?: string;
}

interface LegalLink {
  site: string;
  url: string;
  label?: string;
}

interface Props {
  links?: LinkItem[];
  legalLinks?: LegalLink[];
  type: string;
}

const { links = [], legalLinks = [], type } = Astro.props;
const activeLinks = links.filter(l => (l.is_active ?? l.isActive ?? 1) !== 0);

const hasAny = activeLinks.length > 0 || legalLinks.length > 0;

const sourceGroups = new Map<string, LinkItem[]>();
for (const l of activeLinks) {
  const site = l.source_site || l.sourceSite || 'source';
  if (!sourceGroups.has(site)) sourceGroups.set(site, []);
  sourceGroups.get(site)!.push(l);
}

const linkType = type === 'jeu' ? 'Telechargement' :
                 type === 'book' || type === 'novel' ? 'Lecture / Achat' :
                 'Streaming';

const qualityColors: Record<string, string> = {
  'HD': 'bg-green-500/10 text-green-400 border-green-500/20',
  'FHD': 'bg-blue-500/10 text-blue-400 border-blue-500/20',
  '4K': 'bg-purple-500/10 text-purple-400 border-purple-500/20',
  'SD': 'bg-gray-500/10 text-gray-400 border-gray-500/20',
};
---

{hasAny && (
<div class="space-y-6">
  {legalLinks.length > 0 && (
    <div>
      <h3 class="text-lg font-bold mb-3 text-white/80">Legaux</h3>
      <div class="flex flex-wrap gap-2">
        {legalLinks.map(ll => (
          <a href={ll.url} target="_blank"
             class="text-xs px-4 py-2 rounded-lg bg-emerald-500/10 text-emerald-400 border border-emerald-500/20 hover:bg-emerald-500/20 hover:border-emerald-500/40 transition-all">
            {ll.label || ll.site}
          </a>
        ))}
      </div>
    </div>
  )}

  {activeLinks.length > 0 && (
    <div>
      <h3 class="text-lg font-bold mb-3 text-white/80">{linkType}</h3>
      <div class="flex flex-wrap gap-2">
        {[...sourceGroups.entries()].map(([site, siteLinks]) => {
          const best = siteLinks[0];
          return (
            <a href={best.url} target="_blank"
               class="inline-flex items-center gap-2 text-xs px-4 py-2 rounded-lg bg-primary/10 text-primary border border-primary/20 hover:bg-primary/20 hover:border-primary/40 transition-all">
              {site}
              {best.quality && (
                <span class={`text-[10px] font-bold px-1.5 py-0.5 rounded border ${qualityColors[best.quality] || 'bg-white/5 text-muted-foreground border-white/10'}`}>
                  {best.quality}
                </span>
              )}
              {best.language && (
                <span class="text-[10px] text-muted-foreground">{best.language}</span>
              )}
            </a>
          );
        })}
      </div>
    </div>
  )}
</div>
)}
