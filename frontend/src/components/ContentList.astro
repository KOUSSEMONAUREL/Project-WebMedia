---
import { proxyImage } from '../lib/image';
interface Props { media: any }

const { media } = Astro.props;
const episodes: any[] = media.episodes || [];
const hasEpisodes = episodes.length > 0;

const streamingType = media.type === 'film' ? 'movie' : 'tv';

const seasons = new Map<number, any[]>();
for (const ep of episodes) {
  const s = ep.season_number ?? ep.seasonNumber ?? 1;
  if (!seasons.has(s)) seasons.set(s, []);
  seasons.get(s)!.push(ep);
}
const seasonNums = [...seasons.keys()].sort((a, b) => a - b);

// Episodes are shipped as JSON and rendered client-side: a show like CBS News
// Sunday Morning has 2000+ episodes, and rendering every season's cards up
// front means a huge DOM for a season the user cannot even see yet.
const payloadEpisodes = episodes.map((ep) => {
    const num = ep.episode_number ?? ep.episodeNumber;
    const thumb = ep.thumbnail_url || ep.thumbnailUrl;
    return {
        id: ep.id,
        num,
        season: ep.season_number ?? ep.seasonNumber ?? 1,
        title: ep.title || `Épisode ${num}`,
        duration: ep.duration ?? null,
        synopsis: ep.synopsis || '',
        airDate: ep.air_date ?? ep.airDate ?? null,
        thumb: thumb ? proxyImage(thumb) : null,
    };
});
---

{hasEpisodes && (
<div class="space-y-6 max-w-5xl mx-auto" data-tmdb-id={media.tmdbId || ''}>
  {/* Season selector + filter toggle */}
  <div class="flex flex-wrap items-center gap-3 pb-3 border-b border-white/5">
    <div class="flex items-center gap-2">
      <span class="text-xs font-semibold uppercase tracking-wider" style="color: rgba(255,255,255,0.35);">Saison</span>
      <select
        id="season-select"
        class="px-3 py-2 rounded-xl text-sm font-medium cursor-pointer outline-none transition-all duration-200"
        style="background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.06); color: rgba(255,255,255,0.7);"
      >
        {seasonNums.map((sn) => (
          <option value={sn}>Saison {sn} ({seasons.get(sn)!.length})</option>
        ))}
      </select>
    </div>

    <label class="flex items-center gap-2 cursor-pointer select-none">
      <input type="checkbox" id="season-filter" checked class="sr-only peer" />
      <span
        class="relative inline-block w-9 h-5 rounded-full transition-colors duration-200"
        style="background: rgba(255,255,255,0.1);"
        data-track
      >
        <span
          class="absolute top-0.5 left-0.5 w-4 h-4 rounded-full bg-white transition-transform duration-200"
          data-thumb
        ></span>
      </span>
      <span class="text-xs font-medium" style="color: rgba(255,255,255,0.5);">Toutes les saisons</span>
    </label>

    <span id="episode-count" class="ml-auto text-xs font-mono" style="color: rgba(255,255,255,0.25);"></span>
  </div>

  {/* Episodes grid, filled client-side */}
  <div id="episodes-container"></div>

  <script type="application/json" id="episodes-data" set:html={JSON.stringify(payloadEpisodes).replace(/</g, '\u003c')} />

  {/* Drawer / Detail Panel (Placed below the grid) */}
  <div id="episode-detail-panel" class="hidden rounded-xl p-5 border transition-all duration-300"
       style="background: rgba(255,255,255,0.03); border-color: rgba(255,255,255,0.06);">
    <div class="flex items-start justify-between gap-4 mb-3">
      <div>
        <h3 id="ep-detail-title" class="text-base font-bold text-white/95"></h3>
        <p id="ep-detail-duration" class="text-xs text-white/40 mt-1"></p>
      </div>
      <button id="ep-detail-close" class="text-white/40 hover:text-white/70 transition-colors p-1.5 rounded-lg hover:bg-white/5 cursor-pointer">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>
    
    <div id="ep-detail-synopsis-container" class="rounded-lg p-3.5 mb-4" style="background: rgba(255,255,255,0.02); border: 1px solid rgba(255,255,255,0.04);">
      <p id="ep-detail-synopsis" class="text-sm leading-relaxed" style="color: rgba(255,255,255,0.6);"></p>
    </div>

    <div class="space-y-3">
      <h4 class="text-xs font-semibold uppercase tracking-wider" style="color: rgba(255,255,255,0.35);">Lecteurs disponibles</h4>
      <div id="ep-player-wrapper" class="w-full aspect-video rounded-xl overflow-hidden" style="background: rgba(0,0,0,0.5); display: none;">
        <iframe id="ep-iframe" class="w-full h-full" allow="autoplay; encrypted-media" allowfullscreen referrerpolicy="origin"></iframe>
      </div>
      <div id="ep-source-btns" class="flex flex-wrap gap-2" style="display: none;"></div>
      <div id="ep-no-links" class="text-xs text-white/35" style="display: none;">Aucun lien de visionnage disponible pour cet episode</div>
    </div>
  </div>
</div>
)}

<script>
  function init() {
    const select = document.getElementById('season-select') as HTMLSelectElement | null;
    const filterBox = document.getElementById('season-filter') as HTMLInputElement | null;
    const track = document.querySelector('[data-track]') as HTMLElement | null;
    const thumb = document.querySelector('[data-thumb]') as HTMLElement | null;
    const container = document.getElementById('episodes-container');
    const countEl = document.getElementById('episode-count');
    const dataEl = document.getElementById('episodes-data');
    const panel = document.getElementById('episode-detail-panel');
    const closeBtn = document.getElementById('ep-detail-close');

    const titleEl = document.getElementById('ep-detail-title');
    const durEl = document.getElementById('ep-detail-duration');
    const synEl = document.getElementById('ep-detail-synopsis');
    const synContainer = document.getElementById('ep-detail-synopsis-container');
    const playerWrapper = document.getElementById('ep-player-wrapper');
    const epIframe = document.getElementById('ep-iframe') as HTMLIFrameElement | null;
    const sourceBtns = document.getElementById('ep-source-btns');
    const noLinks = document.getElementById('ep-no-links');

    if (!container || !dataEl || !select) return;

    let episodes: any[] = [];
    try {
      episodes = JSON.parse(dataEl.textContent || '[]');
    } catch {
      episodes = [];
    }

    let activeEpisodeId: string | null = null;

    const esc = (s: any) =>
      String(s ?? '').replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');

    function cardHtml(ep: any) {
      const num = String(ep.num);
      const visual = ep.thumb
        ? '<img src="' + esc(ep.thumb) + '" alt="' + esc(ep.title) + '" class="w-full h-full object-cover rounded-lg" loading="lazy" />'
        : '<span class="text-xl font-bold font-mono" style="color: rgba(255,255,255,0.08);">' + num.padStart(2, '0') + '</span>';
      return (
        '<div class="episode-card rounded-xl p-3 flex gap-3 transition-all cursor-pointer border active:scale-[0.99] select-none"' +
        ' style="background: rgba(255,255,255,0.02); border-color: rgba(255,255,255,0.05);"' +
        ' data-episode-id="' + esc(ep.id) + '" data-season="' + esc(ep.season) + '"' +
        ' data-episode-data="' + esc(JSON.stringify(ep)) + '">' +
        '<div class="w-20 sm:w-28 shrink-0 aspect-video rounded-lg flex items-center justify-center relative overflow-hidden"' +
        ' style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.05);">' + visual + '</div>' +
        '<div class="flex-1 min-w-0 flex flex-col justify-center">' +
        '<div class="flex items-center gap-2">' +
        '<span class="text-xs font-mono font-bold shrink-0" style="color: rgba(255,255,255,0.25);">E' + num.padStart(2, '0') + '</span>' +
        '<h4 class="text-sm font-semibold truncate leading-none" style="color: rgba(255,255,255,0.8);">' + esc(ep.title) + '</h4>' +
        (ep.duration ? '<span class="text-xs shrink-0 ml-auto" style="color: rgba(255,255,255,0.25);">' + esc(ep.duration) + 'm</span>' : '') +
        '</div>' +
        (ep.synopsis ? '<p class="text-xs mt-1.5 line-clamp-1 leading-relaxed" style="color: rgba(255,255,255,0.35);">' + esc(ep.synopsis) + '</p>' : '') +
        '</div></div>'
      );
    }

    const GRID = 'grid gap-3 sm:grid-cols-2 lg:grid-cols-3';

    function render() {
      const showAll = filterBox ? !filterBox.checked : true;
      const wanted = select.value;

      if (showAll) {
        const bySeason = new Map<string, any[]>();
        episodes.forEach((ep) => {
          const k = String(ep.season);
          if (!bySeason.has(k)) bySeason.set(k, []);
          bySeason.get(k)!.push(ep);
        });
        container.innerHTML = [...bySeason.keys()]
          .sort((a, b) => Number(a) - Number(b))
          .map(
            (sn) =>
              '<div class="season-group" data-season="' + sn + '"><div class="mb-2 mt-5 text-xs font-semibold uppercase tracking-wider" style="color: rgba(255,255,255,0.3);">Saison ' +
              sn +
              '</div><div class="' +
              GRID +
              '">' +
              bySeason.get(sn)!.map(cardHtml).join('') +
              '</div></div>'
          )
          .join('');
        if (countEl) countEl.textContent = episodes.length + ' épisodes';
      } else {
        const list = episodes.filter((ep) => String(ep.season) === wanted);
        container.innerHTML =
          '<div class="season-group" data-season="' + esc(wanted) + '"><div class="' + GRID + '">' +
          list.map(cardHtml).join('') +
          '</div></div>';
        if (countEl) {
          const total = episodes.filter((ep) => String(ep.season) === wanted).length;
          countEl.textContent = total + (total > 1 ? ' épisodes' : ' épisode');
        }
      }

      bindCards();
    }

    function bindCards() {
      container.querySelectorAll<HTMLElement>('.episode-card').forEach((el) => {
        el.addEventListener('click', () => {
          const id = el.dataset.episodeId;
          if (id) selectEpisode(id);
        });
      });
    }

    function syncToggle() {
      if (!filterBox || !track || !thumb) return;
      const on = !filterBox.checked;
      track.style.background = on ? 'rgba(5,99,241,0.6)' : 'rgba(255,255,255,0.1)';
      thumb.style.transform = on ? 'translateX(16px)' : 'translateX(0)';
    }

    select.addEventListener('change', render);
    filterBox?.addEventListener('change', () => {
      syncToggle();
      render();
    });

    render();
    syncToggle();

    // Open Episode Detail
    function selectEpisode(id: string, updateHash = true) {
      // The card may not be in the DOM yet (it belongs to another season than
      // the one currently rendered), so switch the season first, then look it up.
      const known = episodes.find((e) => e.id === id);
      if (known) {
        const target = String(known.season);
        const showAll = filterBox ? !filterBox.checked : true;
        if (!showAll && select.value !== target) {
          select.value = target;
          render();
        }
      }

      let selectedCard: HTMLElement | null = null;
      container.querySelectorAll<HTMLElement>('.episode-card').forEach((el) => {
        if (el.dataset.episodeId === id) {
          selectedCard = el;
          el.style.borderColor = 'rgba(96,165,250,0.35)';
          el.style.background = 'rgba(59,130,246,0.04)';
        } else {
          el.style.borderColor = 'rgba(255,255,255,0.05)';
          el.style.background = 'rgba(255,255,255,0.02)';
        }
      });

      if (!selectedCard) return;

      activeEpisodeId = id;
      const epData = JSON.parse(selectedCard.dataset.episodeData || '{}');

      // Populate panel content
      if (titleEl) titleEl.textContent = `Épisode ${epData.num} — ${epData.title}`;
      if (durEl) {
        let meta = epData.duration ? `Durée : ${epData.duration} minutes` : 'Durée inconnue';
        if (epData.airDate) {
          try {
            const d = new Date(typeof epData.airDate === 'number' ? epData.airDate * 1000 : epData.airDate);
            meta += ` · ${d.toLocaleDateString('fr-FR', { year: 'numeric', month: 'long', day: 'numeric' })}`;
          } catch {}
        }
        durEl.textContent = meta;
      }
      
      if (synEl && synContainer) {
        if (epData.synopsis) {
          synEl.textContent = epData.synopsis;
          synContainer.style.display = 'block';
        } else {
          synContainer.style.display = 'none';
        }
      }

      const tmdbId = document.querySelector('[data-tmdb-id]')?.getAttribute('data-tmdb-id');
      if (tmdbId && epData.num && epIframe && sourceBtns && playerWrapper && noLinks) {
        const season = epData.season || 1;
        const SOURCES = [
          { name: 'vsembed.ru', url: (tmdb: number, s: number, e: number) => `https://vsembed.ru/embed/tv?tmdb=${tmdb}&season=${s}&episode=${e}` },
          { name: 'vsembed.su', url: (tmdb: number, s: number, e: number) => `https://vsembed.su/embed/tv?tmdb=${tmdb}&season=${s}&episode=${e}` },
          { name: 'vidsrcme.ru', url: (tmdb: number, s: number, e: number) => `https://vidsrcme.ru/embed/tv?tmdb=${tmdb}&season=${s}&episode=${e}` },
          { name: 'vidsrc.to', url: (tmdb: number, s: number, e: number) => `https://vidsrc.to/embed/tv/${tmdb}/${s}/${e}` },
          { name: '2embed.cc', url: (tmdb: number, s: number, e: number) => `https://www.2embed.cc/embed/${tmdb}${s}${e}` },
        ];
        const num = Number(tmdbId);
        epIframe.src = SOURCES[0].url(num, season, epData.num);
        playerWrapper.style.display = 'block';
        sourceBtns.innerHTML = '';
        sourceBtns.style.display = 'flex';
        noLinks.style.display = 'none';
        SOURCES.forEach((src, i) => {
          const btn = document.createElement('button');
          btn.textContent = src.name;
          btn.dataset.url = src.url(num, season, epData.num);
          btn.className = 'inline-flex items-center gap-1.5 px-4 py-2 rounded-xl text-xs font-semibold transition-all duration-200 hover:scale-[1.02] cursor-pointer';
          btn.style.cssText = i === 0
            ? 'background: rgba(59,130,246,0.12); border: 1px solid rgba(59,130,246,0.25); color: #60A5FA;'
            : 'background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.06); color: rgba(255,255,255,0.7);';
          btn.addEventListener('click', () => {
            if (epIframe) epIframe.src = btn.dataset.url;
            sourceBtns.querySelectorAll('button').forEach(b => {
              b.style.cssText = 'background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.06); color: rgba(255,255,255,0.7);';
            });
            btn.style.cssText = 'background: rgba(59,130,246,0.12); border: 1px solid rgba(59,130,246,0.25); color: #60A5FA;';
          });
          sourceBtns.appendChild(btn);
        });
      } else if (noLinks) {
        if (playerWrapper) playerWrapper.style.display = 'none';
        if (sourceBtns) sourceBtns.style.display = 'none';
        noLinks.style.display = 'block';
      }

      if (panel) {
        panel.classList.remove('hidden');
        setTimeout(() => {
          panel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }, 50);
      }

      if (updateHash) {
        history.replaceState(null, '', `#episode-${id}`);
      }
    }

    // Close Panel
    function closePanel() {
      activeEpisodeId = null;
      container.querySelectorAll<HTMLElement>('.episode-card').forEach((el) => {
        el.style.borderColor = 'rgba(255,255,255,0.05)';
        el.style.background = 'rgba(255,255,255,0.02)';
      });

      if (epIframe) epIframe.src = '';
      if (playerWrapper) playerWrapper.style.display = 'none';
      if (sourceBtns) sourceBtns.style.display = 'none';
      if (noLinks) noLinks.style.display = 'none';
      if (panel) panel.classList.add('hidden');
      history.replaceState(null, '', window.location.pathname);
    }

    // Card listeners are re-attached on every render() by bindCards().
    closeBtn?.addEventListener('click', closePanel);

    // Default view is already rendered: the select holds the first season and
    // the filter is checked, so only that season's episodes are in the DOM.

    // Route hash on load
    if (window.location.hash.startsWith('#episode-')) {
      const id = window.location.hash.replace('#episode-', '');
      setTimeout(() => selectEpisode(id, false), 150);
    }

    const onHashChange = () => {
      if (window.location.hash.startsWith('#episode-')) {
        const id = window.location.hash.replace('#episode-', '');
        if (id !== activeEpisodeId) selectEpisode(id, false);
      } else {
        closePanel();
      }
    };

    window.addEventListener('hashchange', onHashChange);

    document.addEventListener('astro:before-swap', () => {
      window.removeEventListener('hashchange', onHashChange);
    }, { once: true });
  }

  // Runs on initial page load and after every page transition
  document.addEventListener('astro:page-load', init);
</script>
