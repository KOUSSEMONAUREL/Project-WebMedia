---
interface Props { media: any }

const { media } = Astro.props;
const episodes: any[] = media.episodes || [];
const hasEpisodes = episodes.length > 0;

const allLinks: any[] = (media.links || []).filter((l: any) => (l.is_active ?? l.isActive ?? 1) !== 0);

const seasons = new Map<number, any[]>();
for (const ep of episodes) {
  const s = ep.season_number ?? ep.seasonNumber ?? 1;
  if (!seasons.has(s)) seasons.set(s, []);
  seasons.get(s)!.push(ep);
}
const seasonNums = [...seasons.keys()].sort();
---

{hasEpisodes && (
<div class="space-y-10 max-w-5xl mx-auto">
  {seasonNums.map((sn) => {
    const eps = seasons.get(sn)!;
    return (
      <section>
        <div class="flex items-center gap-3 mb-5">
          <h2 class="text-lg font-bold" style="color: rgba(255,255,255,0.85);">Saison {sn}</h2>
          <span class="text-xs" style="color: rgba(255,255,255,0.3);">{eps.length} épisode{eps.length > 1 ? 's' : ''}</span>
          <div class="flex-1 h-px" style="background: linear-gradient(90deg, rgba(255,255,255,0.06), transparent);"></div>
        </div>

        <div class="grid gap-2.5 sm:grid-cols-2">
          {eps.map(ep => {
            const num = ep.episode_number ?? ep.episodeNumber;
            const title = ep.title || `Épisode ${num}`;
            const dur = ep.duration;
            const synopsis = ep.synopsis;
            const epLinks = allLinks.filter((l: any) => {
              const lid = l.episode_id ?? l.episodeId;
              return lid && lid === ep.id;
            });

            return (
              <div class="rounded-xl p-3 flex gap-3 transition-colors"
                   style="background: rgba(255,255,255,0.02); border: 1px solid rgba(255,255,255,0.05);">
                <div class="w-20 sm:w-28 shrink-0 aspect-video rounded-lg flex items-center justify-center"
                     style="background: rgba(255,255,255,0.03);">
                  {(ep.thumbnail_url || ep.thumbnailUrl) ? (
                    <img src={ep.thumbnail_url || ep.thumbnailUrl} alt={title} class="w-full h-full object-cover rounded-lg" loading="lazy" />
                  ) : (
                    <span class="text-lg font-bold" style="color: rgba(255,255,255,0.08);">{String(num).padStart(2, '0')}</span>
                  )}
                </div>
                <div class="flex-1 min-w-0 flex flex-col justify-center">
                  <div class="flex items-center gap-2">
                    <span class="text-xs font-mono font-bold shrink-0" style="color: rgba(255,255,255,0.25);">E{String(num).padStart(2, '0')}</span>
                    <span class="text-sm font-medium truncate" style="color: rgba(255,255,255,0.8);">{title}</span>
                    {dur && <span class="text-xs shrink-0 ml-auto" style="color: rgba(255,255,255,0.25);">{dur}min</span>}
                  </div>
                  {synopsis && (
                    <p class="text-xs mt-1 line-clamp-2 leading-relaxed" style="color: rgba(255,255,255,0.35);">{synopsis}</p>
                  )}
                  {epLinks.length > 0 && (
                    <div class="flex flex-wrap gap-1.5 mt-2">
                      {epLinks.slice(0, 4).map((l: any) => (
                        <a href={l.url} target="_blank"
                           class="text-[11px] font-medium px-2.5 py-1 rounded-lg transition-colors"
                           style="background: rgba(59,130,246,0.08); color: #60A5FA;">
                          {l.source_site || l.sourceSite || 'Voir'}
                          {l.quality ? ` ${l.quality}` : ''}
                        </a>
                      ))}
                    </div>
                  )}
                  {epLinks.length === 0 && (
                    <span class="text-[11px] mt-1.5" style="color: rgba(255,255,255,0.12);">Aucun lien disponible</span>
                  )}
                </div>
              </div>
            );
          })}
        </div>
      </section>
    );
  })}
</div>
)}
