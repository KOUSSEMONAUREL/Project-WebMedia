---
interface Props {
  media: any;
}

const { media } = Astro.props;

const episodes: any[] = media.episodes || [];
const isEpisodeBased = media.type === 'serie' || media.type === 'anime';
const show = isEpisodeBased && episodes.length > 0;

const seasons = new Map<number, any[]>();
for (const ep of episodes) {
  const s = ep.season_number ?? ep.seasonNumber ?? 1;
  if (!seasons.has(s)) seasons.set(s, []);
  seasons.get(s)!.push(ep);
}

const seasonNums = [...seasons.keys()].sort();
---

{show && (
<div class="max-w-4xl mx-auto" id="episodes-section">
  <div class="flex items-center gap-3 mb-6">
    <h3 class="text-lg font-bold text-white/90">Episodes</h3>
    {media.episodeCount && (
      <span class="text-xs text-white/30 glass-card px-2 py-0.5 rounded-md">{media.episodeCount} au total</span>
    )}
  </div>

  {seasonNums.length > 1 && (
    <div class="flex gap-2 mb-6 overflow-x-auto scrollbar-hide -mx-4 px-4">
      {seasonNums.map(sn => (
        <button data-season={sn}
          class="season-tab text-sm px-4 py-2 rounded-lg glass-card glass-hover text-white/50 font-medium whitespace-nowrap transition-all"
          onclick="selectSeason(this)">
          Saison {sn}
        </button>
      ))}
    </div>
  )}

  {seasonNums.map(sn => {
    const eps = seasons.get(sn)!;
    return (
      <div class="season-group" data-season={sn} style={{ display: sn === seasonNums[0] ? 'block' : 'none' }}>
        <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {eps.map(ep => {
            const epNum = ep.episode_number ?? ep.episodeNumber;
            const epTitle = ep.title || `Episode ${epNum}`;
            const duration = ep.duration;
            const epId = ep.id;
            return (
              <a href={`#episode-${epId}`}
                 data-episode-id={epId}
                 class="episode-card glass-card glass-hover rounded-xl p-3.5 block no-underline transition-all"
                 onclick="event.preventDefault(); toggleEpisode(this.dataset.episodeId)">
                {ep.thumbnail_url || ep.thumbnailUrl ? (
                  <div class="aspect-video rounded-lg overflow-hidden mb-2.5 bg-white/[0.02]">
                    <img src={ep.thumbnail_url || ep.thumbnailUrl} alt={epTitle}
                         class="w-full h-full object-cover" loading="lazy" />
                  </div>
                ) : (
                  <div class="aspect-video rounded-lg mb-2.5 bg-gradient-to-br from-white/[0.03] to-white/[0.01] flex items-center justify-center">
                    <span class="text-white/10 text-2xl font-mono font-bold">{String(epNum).padStart(2, '0')}</span>
                  </div>
                )}
                <div class="flex items-start gap-2">
                  <span class="text-white/30 text-xs font-mono shrink-0 mt-0.5">E{String(epNum).padStart(2, '0')}</span>
                  <div class="min-w-0 flex-1">
                    <p class="text-sm text-white/80 font-medium leading-snug line-clamp-1">{epTitle}</p>
                    {duration && <span class="text-[11px] text-white/30">{duration} min</span>}
                  </div>
                </div>
              </a>
            );
          })}
        </div>
      </div>
    );
  })}

  <div id="episode-panel" class="hidden mt-4 glass-card rounded-xl p-5 transition-all">
    <div class="flex items-start justify-between gap-4 mb-3">
      <div>
        <h4 id="ep-panel-title" class="text-base font-bold text-white/90"></h4>
        <p id="ep-panel-meta" class="text-xs text-white/40 mt-0.5"></p>
      </div>
      <button onclick="closeEpisodePanel()" class="text-white/30 hover:text-white/60 transition-colors shrink-0">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>
    <p id="ep-panel-synopsis" class="text-sm text-white/50 leading-relaxed mb-4"></p>
    <div id="ep-panel-links" class="flex flex-wrap gap-2"></div>
  </div>
</div>
)}

<script>
  window.__episodes = (() => {
    const all: any[] = [];
    const containers = document.querySelectorAll('.season-group');
    containers.forEach((g) => {
      const cards = g.querySelectorAll('.episode-card');
      cards.forEach((c) => {
        const el = c as HTMLElement;
        const id = el.dataset.episodeId;
        const num = el.querySelector('.text-mono')?.textContent?.trim();
        all.push({ id, el });
      });
    });
    return all;
  })();

  function selectSeason(btn: HTMLElement) {
    const sn = btn.dataset.season;
    document.querySelectorAll('.season-tab').forEach(t => {
      (t as HTMLElement).classList.remove('bg-white/10', 'text-white/80');
      (t as HTMLElement).classList.add('text-white/50');
    });
    btn.classList.remove('text-white/50');
    btn.classList.add('bg-white/10', 'text-white/80');
    document.querySelectorAll('.season-group').forEach(g => {
      (g as HTMLElement).style.display = (g as HTMLElement).dataset.season === sn ? 'block' : 'none';
    });
    closeEpisodePanel();
  }

  (window as any).toggleEpisode = function(episodeId: string) {
    const panel = document.getElementById('episode-panel')!;
    const allLinks: any[] = (window as any).__mediaLinks || [];

    // Try to find episode data from all episodes
    const allEps = document.querySelectorAll('.episode-card');
    let target: HTMLElement | null = null;
    allEps.forEach((e) => {
      if ((e as HTMLElement).dataset.episodeId === episodeId) target = e as HTMLElement;
    });
    if (!target) return;

    const epLinks = allLinks.filter((l: any) => {
      const lid = l.episode_id ?? l.episodeId;
      return lid === episodeId;
    });

    const titleEl = target.querySelector('.text-sm.text-white\\/80')?.textContent || 'Episode';
    const numEl = target.querySelector('.text-mono')?.textContent || '';
    const durationEl = target.querySelector('.text-\\[11px\\]')?.textContent || '';

    document.getElementById('ep-panel-title')!.textContent = `${numEl} - ${titleEl}`;
    document.getElementById('ep-panel-meta')!.textContent = durationEl;

    // Get synopsis from data
    const synopsisEl = document.getElementById('ep-panel-synopsis')!;
    synopsisEl.textContent = 'Aucun synopsis disponible pour cet episode.';

    const linksContainer = document.getElementById('ep-panel-links')!;
    linksContainer.innerHTML = '';
    if (epLinks.length > 0) {
      epLinks.forEach((l: any) => {
        const site = l.source_site ?? l.sourceSite ?? 'Source';
        const a = document.createElement('a');
        a.href = l.url;
        a.target = '_blank';
        a.className = 'text-xs px-3 py-1.5 rounded-lg glass-card text-primary hover:bg-primary/10 transition-all';
        a.textContent = site;
        if (l.quality) {
          const badge = document.createElement('span');
          badge.className = 'text-[10px] font-bold ml-1.5 px-1.5 py-0.5 rounded border border-white/10 text-white/40';
          badge.textContent = l.quality;
          a.appendChild(badge);
        }
        linksContainer.appendChild(a);
      });
    } else {
      linksContainer.innerHTML = '<span class="text-xs text-white/30">Aucun lien disponible pour cet episode.</span>';
    }

    panel.classList.remove('hidden');
    panel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    window.location.hash = `episode-${episodeId}`;
  };

  function closeEpisodePanel() {
    document.getElementById('episode-panel')!.classList.add('hidden');
    history.replaceState(null, '', window.location.pathname);
  }

  (window as any).closeEpisodePanel = closeEpisodePanel;

  // Init first season tab
  document.addEventListener('DOMContentLoaded', () => {
    const first = document.querySelector('.season-tab');
    if (first) {
      (first as HTMLElement).classList.add('bg-white/10', 'text-white/80');
      (first as HTMLElement).classList.remove('text-white/50');
    }
    // Check hash on load
    if (window.location.hash.startsWith('#episode-')) {
      const id = window.location.hash.replace('#episode-', '');
      setTimeout(() => (window as any).toggleEpisode(id), 100);
    }
  });

  window.addEventListener('hashchange', () => {
    if (window.location.hash.startsWith('#episode-')) {
      const id = window.location.hash.replace('#episode-', '');
      (window as any).toggleEpisode(id);
    } else {
      closeEpisodePanel();
    }
  });
</script>
