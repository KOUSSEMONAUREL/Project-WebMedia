---
import '../styles/global.css';
import { Navbar } from '../components/Navbar';
import { CookieBanner } from '../components/CookieBanner';
import { VerificationBanner } from '../components/VerificationBanner';
import { ToastInit } from '../components/ToastInit';
import { BackToTop } from '../components/BackToTop';
import ClientRouter from 'astro/components/ClientRouter.astro';

interface Props {
    title: string;
    description?: string;
}

const { title, description = 'WebMediia - Annuaire de streaming gratuit : films, series, animes, mangas, webtoons, jeux, livres et light novels. Accedez aux meilleurs contenus sans inscription.' } = Astro.props;
---

<!doctype html>
<html lang="fr">
    <head>
        <meta charset="UTF-8" />
        <meta name="description" content={description} />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link rel="icon" type="image/png" href="/favicon.png" />
        <link rel="apple-touch-icon" href="/favicon.png" />
        <meta name="generator" content={Astro.generator} />
        <ClientRouter />
        
        <title>{title} | WebMediia</title>
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:type" content="website" />
        <meta property="og:image" content="https://www.webmediia.cfd/images/logo.png" />
        <meta property="og:url" content={Astro.url.href} />
        <meta property="og:site_name" content="WebMediia" />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content="https://www.webmediia.cfd/images/logo.png" />

        <link rel="preconnect" href="https://api.fontshare.com" crossorigin>
        <link href="https://api.fontshare.com/v2/css?f[]=satoshi@300,400,500,600,700&f[]=clash-display@400,500,600,700&display=swap" rel="stylesheet" media="print" onload="this.media='all'">

        <meta name="bc14130edae9fcd074dff1fe4c4b55ead59835e6" content="bc14130edae9fcd074dff1fe4c4b55ead59835e6" />
        <meta name="referrer" content="no-referrer-when-downgrade" />
        <!-- 
            Google Search Console verification attempt — 19/07/2026
            
            Problem: Google OAuth consent screen validation fails because
            Cloudflare Turnstile blocks Google's validator from seeing content.
            Root page returns a challenge page instead of actual content.
            
            Solution tried: Created /about page as static verification target,
            added sitemap, robots.txt, humans.txt, security.txt.
            Google Auth Platform home page URL set to /about.
            
            Domain verified via Cloudflare DNS TXT record automatically.
            Sitemap submitted: /sitemap-index.xml
            Verification meta tag removed — using DNS TXT method instead.
        -->

    </head>
    <body class="min-h-screen bg-background text-foreground font-sans overflow-x-hidden">
        <Navbar client:idle initialPathname={Astro.url.pathname} />
        <VerificationBanner client:visible />
        <main class="flex-1 pt-[74px]">
            <slot />
        </main>
        <footer class="border-t border-border/30 mt-16">
            <div class="max-w-7xl mx-auto px-4 py-12">
                <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
                    <div class="md:col-span-2">
                        <h4 class="text-sm font-semibold mb-3 text-foreground">Qui sommes-nous</h4>
                        <p class="text-xs text-muted-foreground leading-relaxed max-w-md">
                            WebMediia est un annuaire de streaming gratuit référençant des films, séries, animes, mangas, webtoons, jeux, livres et light novels.
                        </p>
                        <p class="text-[11px] text-muted-foreground/50 mt-3 leading-relaxed max-w-md">
                            WebMediia n'héberge pas les contenus. Pour toute réclamation, veuillez contacter la plateforme d'hébergement concernée.
                        </p>
                    </div>
                    <div>
                        <h4 class="text-sm font-semibold mb-3 text-foreground">Liens utiles</h4>
                        <ul class="space-y-2">
                            <li><a href="/" class="text-xs text-muted-foreground hover:text-foreground transition-colors">Accueil</a></li>
                            <li><a href="/about" class="text-xs text-muted-foreground hover:text-foreground transition-colors">À propos</a></li>
                            <li><a href="/legal" class="text-xs text-muted-foreground hover:text-foreground transition-colors">Mentions légales</a></li>
                            <li><a href="/contact" class="text-xs text-muted-foreground hover:text-foreground transition-colors">Contact</a></li>
                        </ul>
                    </div>
                    <div>
                        <h4 class="text-sm font-semibold mb-3 text-foreground">Catégories</h4>
                        <ul class="space-y-2">
                            <li><a href="/type/film" class="text-xs text-muted-foreground hover:text-foreground transition-colors">Films</a></li>
                            <li><a href="/type/serie" class="text-xs text-muted-foreground hover:text-foreground transition-colors">Séries</a></li>
                            <li><a href="/type/anime" class="text-xs text-muted-foreground hover:text-foreground transition-colors">Animes</a></li>
                            <li><a href="/type/jeu" class="text-xs text-muted-foreground hover:text-foreground transition-colors">Jeux</a></li>
                            <li><a href="/type/book" class="text-xs text-muted-foreground hover:text-foreground transition-colors">Livres & Light Novels</a></li>
                        </ul>
                    </div>
                </div>
            </div>
            <div class="border-t border-border/20 px-4 py-5">
                <div class="max-w-7xl mx-auto flex flex-col sm:flex-row items-center justify-between gap-3">
                    <div class="flex items-center gap-2">
                        <span class="text-sm font-semibold text-foreground">WebMediia</span>
                        <span class="text-xs text-muted-foreground">© 2026 Tous droits réservés</span>
                    </div>
                    <div class="flex items-center gap-4">
                        <a href="https://discord.gg/4E5YXXFaHg" target="_blank" rel="noopener" class="text-muted-foreground hover:text-foreground transition-colors" aria-label="Discord">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" fill="currentColor" viewBox="0 0 16 16">
                                <path d="M13.545 2.907a13.2 13.2 0 0 0-3.257-1.011.05.05 0 0 0-.052.025c-.141.25-.297.577-.406.833a12.2 12.2 0 0 0-3.658 0 8 8 0 0 0-.412-.833.05.05 0 0 0-.052-.025 13.2 13.2 0 0 0-3.257 1.011.05.05 0 0 0-.021.018C.356 6.421-.13 9.583.099 12.57a.05.05 0 0 0 .019.03 13.3 13.3 0 0 0 4.027 2.04.05.05 0 0 0 .053-.018 10.3 10.3 0 0 0 .825-1.344.05.05 0 0 0-.027-.07 8.8 8.8 0 0 1-1.258-.6.05.05 0 0 1-.005-.083 10 10 0 0 0 .246-.162.05.05 0 0 1 .048-.003 9.3 9.3 0 0 0 7.858 0 .05.05 0 0 1 .048.003q.12.08.246.162a.05.05 0 0 1-.005.082 8.8 8.8 0 0 1-1.258.6.05.05 0 0 0-.027.07c.32.468.594.91.825 1.345a.05.05 0 0 0 .053.018 13.3 13.3 0 0 0 4.028-2.04.05.05 0 0 0 .019-.03c.278-3.53-.467-6.676-1.788-9.645a.04.04 0 0 0-.021-.019M5.79 10.87c-.787 0-1.434-.722-1.434-1.607s.639-1.607 1.434-1.607c.802 0 1.442.73 1.434 1.607 0 .885-.639 1.607-1.434 1.607m4.42 0c-.787 0-1.434-.722-1.434-1.607s.64-1.607 1.434-1.607c.802 0 1.442.73 1.434 1.607 0 .885-.632 1.607-1.434 1.607"/>
                            </svg>
                        </a>
                        <a href="https://x.com/koussem_aurel" target="_blank" rel="noopener" class="text-muted-foreground hover:text-foreground transition-colors" aria-label="X">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16">
                                <path d="M12.6.75h2.454l-5.36 6.142L16 15.25h-4.937l-3.867-5.07-4.425 5.07H.316l5.733-6.57L0 .75h5.063l3.495 4.633L12.601.75Zm-.86 13.028h1.36L4.323 2.145H2.865l8.875 11.633Z"/>
                            </svg>
                        </a>
                    </div>
                </div>
            </div>
        </footer>
    </body>
    <CookieBanner client:visible />
    <BackToTop client:visible />
    <ToastInit client:only="react" />
    <script>
        import { initSyncSession } from '../lib/sync-queue';
        initSyncSession();
    </script>
</html>
