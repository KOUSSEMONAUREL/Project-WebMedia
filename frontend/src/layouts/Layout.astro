---
import '../styles/global.css';
import { Navbar } from '../components/Navbar';
import { CookieBanner } from '../components/CookieBanner';
import { VerificationBanner } from '../components/VerificationBanner';
import ClientRouter from 'astro/components/ClientRouter.astro';

interface Props {
    title: string;
    description?: string;
}

const { title, description = 'Découvrez les meilleurs films, séries, animés, jeux et webtoons' } = Astro.props;
---

<!doctype html>
<html lang="fr">
    <head>
        <meta charset="UTF-8" />
        <meta name="description" content={description} />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="generator" content={Astro.generator} />
        <ClientRouter />
        
        <title>{title} | WebMedia</title>
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:type" content="website" />

        <link rel="preconnect" href="https://api.fontshare.com" crossorigin>
        <link href="https://api.fontshare.com/v2/css?f[]=satoshi@300,400,500,600,700&f[]=clash-display@400,500,600,700&display=swap" rel="stylesheet" media="print" onload="this.media='all'">

        <meta name="bc14130edae9fcd074dff1fe4c4b55ead59835e6" content="bc14130edae9fcd074dff1fe4c4b55ead59835e6" />

        {
            import.meta.env.PROD && (
                <>
                    <script src="https://quge5.com/88/tag.min.js" data-zone="259349" async data-cfasync="false"></script>
                    <script>(function(ces){var d = document, s = d.createElement('script'), l = d.scripts[d.scripts.length - 1];s.settings = ces || {};s.src = "\/\/elderlygoal.com\/cyD.9B6vbF2e5QlwSVWmQS9xNhzmIqyoM-DoE\/3BMiye0\/3KMSjIISwhMNTvcV3D";s.async = true;s.referrerPolicy = 'no-referrer-when-downgrade';l.parentNode.insertBefore(s, l);})({})</script>
                </>
            )
        }
    </head>
    <body class="min-h-screen bg-background text-foreground font-sans overflow-x-hidden">
        <Navbar client:idle initialPathname={Astro.url.pathname} />
        <VerificationBanner client:visible />
        <main class="flex-1 pt-[74px]">
            <slot />
        </main>
        <footer class="border-t border-border/30 mt-16 py-8 px-4 text-center">
            <p class="text-muted-foreground text-xs">© 2025 WebMedia · Tous droits réservés</p>
        </footer>
    </body>
    <CookieBanner client:visible />
    <div id="nprogress"><div class="bar"></div></div>
    <script>
        import { initSyncSession } from '../lib/sync-queue';
        initSyncSession();
        const bar = document.querySelector('#nprogress .bar');
        if (bar) {
            let timer;
            document.addEventListener('astro:before-swap', () => {
                clearTimeout(timer);
                bar.style.transition = 'width 0.3s ease';
                bar.style.width = '30%';
                bar.style.opacity = '1';
            });
            document.addEventListener('astro:after-swap', () => {
                bar.style.transition = 'width 0.15s ease';
                bar.style.width = '100%';
                timer = setTimeout(() => {
                    bar.style.transition = 'opacity 0.3s ease';
                    bar.style.opacity = '0';
                    setTimeout(() => { bar.style.width = '0'; }, 300);
                }, 200);
            });
        }
    </script>
</html>
