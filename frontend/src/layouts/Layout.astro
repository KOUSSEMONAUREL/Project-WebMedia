---
import '../styles/global.css';
import { Navbar } from '../components/Navbar';
import { CookieBanner } from '../components/CookieBanner';
import { VerificationBanner } from '../components/VerificationBanner';
import { ToastInit } from '../components/ToastInit';
import ClientRouter from 'astro/components/ClientRouter.astro';

interface Props {
    title: string;
    description?: string;
}

const { title, description = 'WebMediia - Annuaire de streaming gratuit : films, series, animes, mangas, webtoons, jeux, livres et light novels. Accedez aux meilleurs contenus sans inscription.' } = Astro.props;
---

<!doctype html>
<html lang="fr">
    <head>
        <meta charset="UTF-8" />
        <meta name="description" content={description} />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link rel="icon" type="image/png" href="/favicon.png" />
        <link rel="apple-touch-icon" href="/favicon.png" />
        <meta name="generator" content={Astro.generator} />
        <ClientRouter />
        
        <title>{title} | WebMediia</title>
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:type" content="website" />
        <meta property="og:image" content="https://www.webmediia.cfd/images/logo.png" />
        <meta property="og:url" content={Astro.url.href} />
        <meta property="og:site_name" content="WebMediia" />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content="https://www.webmediia.cfd/images/logo.png" />

        <link rel="preconnect" href="https://api.fontshare.com" crossorigin>
        <link href="https://api.fontshare.com/v2/css?f[]=satoshi@300,400,500,600,700&f[]=clash-display@400,500,600,700&display=swap" rel="stylesheet" media="print" onload="this.media='all'">

        <meta name="bc14130edae9fcd074dff1fe4c4b55ead59835e6" content="bc14130edae9fcd074dff1fe4c4b55ead59835e6" />
        <meta name="referrer" content="no-referrer-when-downgrade" />
        <!-- 
            Google Search Console verification attempt — 19/07/2026
            
            Problem: Google OAuth consent screen validation fails because
            Cloudflare Turnstile blocks Google's validator from seeing content.
            Root page returns a challenge page instead of actual content.
            
            Solution tried: Created /about page as static verification target,
            added sitemap, robots.txt, humans.txt, security.txt.
            Google Auth Platform home page URL set to /about.
            
            Domain verified via Cloudflare DNS TXT record automatically.
            Sitemap submitted: /sitemap-index.xml
            Verification meta tag removed — using DNS TXT method instead.
        -->

    </head>
    <body class="min-h-screen bg-background text-foreground font-sans overflow-x-hidden">
        <Navbar client:idle initialPathname={Astro.url.pathname} />
        <VerificationBanner client:visible />
        <main class="flex-1 pt-[74px]">
            <slot />
        </main>
        <footer class="border-t border-border/30 mt-16 py-8 px-4 text-center">
            <p class="text-muted-foreground text-xs">
                <a href="/legal" class="hover:text-foreground transition-colors">Mentions legales</a>
                <span class="mx-2 opacity-30">·</span>
                © 2025 WebMediia
            </p>
            <p class="text-[10px] text-muted-foreground/50 mt-2 max-w-md mx-auto leading-relaxed">
                WebMediia est un annuaire de streaming gratuit referenceant des films, series, animes, mangas, webtoons, jeux, livres et light novels.
            </p>
        </footer>
    </body>
    <CookieBanner client:visible />
    <ToastInit client:only="react" />
    <script>
        import { initSyncSession } from '../lib/sync-queue';
        initSyncSession();
    </script>
</html>
