---
import '../styles/global.css';
import { Navbar } from '../components/Navbar';
import { CookieBanner } from '../components/CookieBanner';
import { VerificationBanner } from '../components/VerificationBanner';
import ClientRouter from 'astro/components/ClientRouter.astro';

interface Props {
    title: string;
    description?: string;
}

const { title, description = 'Découvrez les meilleurs films, séries, animés, jeux et webtoons' } = Astro.props;
---

<!doctype html>
<html lang="fr">
    <head>
        <meta charset="UTF-8" />
        <meta name="description" content={description} />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="generator" content={Astro.generator} />
        <ClientRouter />
        
        <title>{title} | WebMedia</title>
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:type" content="website" />

        <link rel="preconnect" href="https://api.fontshare.com" crossorigin>
        <link href="https://api.fontshare.com/v2/css?f[]=satoshi@300,400,500,600,700&f[]=clash-display@400,500,600,700&display=swap" rel="stylesheet" media="print" onload="this.media='all'">
    </head>
    <body class="min-h-screen bg-background text-foreground font-sans overflow-x-hidden">
        <Navbar client:idle initialPathname={Astro.url.pathname} />
        <VerificationBanner client:visible />
        <main class="flex-1 pt-[74px]">
            <slot />
        </main>
        <footer class="border-t border-border/30 mt-16 py-8 px-4 text-center">
            <p class="text-muted-foreground text-xs">© 2025 WebMedia · Tous droits réservés</p>
        </footer>
    </body>
    <CookieBanner client:visible />
    <div id="nav-skeleton" aria-hidden="true" class="fixed inset-0 z-30 bg-background pt-[74px] hidden">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 py-8 animate-pulse">
            <div class="h-8 bg-muted rounded w-48 mb-6" />
            <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 xl:grid-cols-5 gap-4">
                {Array.from({ length: 10 }).map((_, i) => (
                    <div key={i} class="bg-card rounded-xl p-4 border border-border">
                        <div class="w-full aspect-video bg-muted rounded-lg mb-3" />
                        <div class="h-4 bg-muted rounded w-3/4 mb-2" />
                        <div class="h-3 bg-muted rounded w-1/3" />
                    </div>
                ))}
            </div>
        </div>
    </div>
    <script>
        import { initSyncSession } from '../lib/sync-queue';
        initSyncSession();
        const skeleton = document.getElementById('nav-skeleton');
        if (skeleton) {
            document.addEventListener('astro:before-swap', () => skeleton.classList.remove('hidden'));
            document.addEventListener('astro:after-swap', () => skeleton.classList.add('hidden'));
        }
    </script>
</html>
