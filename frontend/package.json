{
  "name": "frontend",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "ASTRO_LOG_LEVEL=warn astro build && node -e \"const{readFileSync,writeFileSync}=require('fs');const p='dist/server/wrangler.json';try{const c=JSON.parse(readFileSync(p,'utf-8'));delete c.legacy_env;writeFileSync(p,JSON.stringify(c))}catch(e){console.error('Failed to strip legacy_env:',e.message)}\"",
    "preview": "astro preview",
    "astro": "astro",
    "check-lockfile": "npm ls --package-lock-only",
    "doctor": "npx react-doctor@latest"
  },
