{
  "name": "frontend",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "build": "ASTRO_LOG_LEVEL=warn astro build && node -e \"const{readFileSync,writeFileSync}=require('fs');const p='dist/server/wrangler.json';try{const c=JSON.parse(readFileSync(p,'utf-8'));delete c.legacy_env;writeFileSync(p,JSON.stringify(c))}catch(e){console.error('Failed to strip legacy_env:',e.message)}\"",
    "preview": "astro preview",
    "astro": "astro",
    "check-lockfile": "npm ls --package-lock-only",
    "postinstall": "patch-package",
    "doctor": "npx react-doctor@latest"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.1.5",
    "@astrojs/react": "^6.0.1",
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/vercel": "^11.0.2",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-dialog": "^1.1.18",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.101.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "astro": "^7.1.4",
    "better-auth": "^1.6.23",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "hls.js": "^1.6.16",
    "idb": "^8.0.3",
    "lucide-react": "^1.27.0",
    "plyr": "^3.8.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-is": "^19.2.8",
    "recharts": "^3.10.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite-plugin-pwa": "^1.3.0"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "patch-package": "^8.0.1",
    "react-doctor": "^0.9.2",
    "wrangler": "^4"
  }
}
